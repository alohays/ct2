{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HOME}/.ct2/claude-plugin/hooks/enforce-write-access.sh\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HOME}/.ct2/claude-plugin/hooks/enforce-review-independence.sh\""
          }
        ]
      }
    ]
  }
}
