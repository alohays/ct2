{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HOME}/.ct2/claude-plugin/hooks/enforce-write-access.sh\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HOME}/.ct2/claude-plugin/hooks/enforce-review-independence.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d \"${CT2_DIR:-.ct2}/.meta\" ] && [ -n \"${CT2_ROLE:-}\" ]; then date -u > \"${CT2_DIR:-.ct2}/.meta/ct2-${CT2_ROLE}.heartbeat\"; fi"
          }
        ]
      }
    ]
  }
}
