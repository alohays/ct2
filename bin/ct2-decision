#!/usr/bin/env python3
"""Manage provider-neutral CT2 decision records."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from _ct2_vao import atomic_write_json, ensure_ct2, new_id, now


def read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def find_record(ct2_dir: Path, decision_id: str) -> tuple[Path, dict] | None:
    for state in ("pending", "answered", "expired", "audit"):
        path = ct2_dir / "decisions" / state / f"{decision_id}.json"
        if path.exists():
            return path, read_json(path)
    return None


def provider_payload(record: dict, provider: str) -> dict:
    options = [str(option) for option in record.get("options") or []]
    if provider == "codex":
        return {
            "provider": "codex",
            "method": "item/tool/requestUserInput",
            "params": {
                "questions": [
                    {
                        "header": str(record.get("kind") or "Decision")[:12],
                        "id": "choice",
                        "question": record.get("question"),
                        "options": [
                            {"label": option, "description": f"Select {option}."}
                            for option in options[:3]
                        ],
                    }
                ]
            },
            "decision_id": record.get("id"),
        }
    if provider == "claude":
        return {
            "provider": "claude",
            "tool": "AskUserQuestion",
            "arguments": {
                "question": record.get("question"),
                "options": options,
                "metadata": {
                    "decision_id": record.get("id"),
                    "role": record.get("role"),
                    "ticket": record.get("ticket"),
                    "kind": record.get("kind"),
                },
            },
        }
    raise SystemExit(f"ct2-decision: unsupported provider format {provider}")


def cmd_ask(args: argparse.Namespace) -> int:
    project_dir = Path(args.project_dir).resolve()
    ct2_dir = ensure_ct2(project_dir)
    decision_id = new_id("decision")
    record = {
        "id": decision_id,
        "schema_version": "1",
        "status": "pending",
        "created_at": now(),
        "provider": args.provider,
        "role": args.role,
        "ticket": args.ticket,
        "question": args.question,
        "options": args.option or [],
        "kind": args.kind,
    }
    dest = ct2_dir / "decisions" / "pending" / f"{decision_id}.json"
    atomic_write_json(ct2_dir, dest, record, "decision-ask-")
    if args.json:
        print(json.dumps(record, indent=2, sort_keys=True))
    else:
        print(f"ct2-decision: pending {decision_id}")
    return 0


def cmd_answer(args: argparse.Namespace) -> int:
    project_dir = Path(args.project_dir).resolve()
    ct2_dir = ensure_ct2(project_dir)
    pending = ct2_dir / "decisions" / "pending" / f"{args.decision_id}.json"
    if not pending.exists():
        print(f"ct2-decision: pending decision not found: {args.decision_id}", file=sys.stderr)
        return 1
    record = read_json(pending)
    options = record.get("options") or []
    if options and args.choice not in options:
        print(f"ct2-decision: choice must be one of: {', '.join(options)}", file=sys.stderr)
        return 1
    record.update({"status": "answered", "answered_at": now(), "choice": args.choice})
    answered = ct2_dir / "decisions" / "answered" / pending.name
    audit = ct2_dir / "decisions" / "audit" / pending.name
    atomic_write_json(ct2_dir, answered, record, "decision-answer-")
    atomic_write_json(ct2_dir, audit, record, "decision-audit-")
    pending.unlink()
    if args.json:
        print(json.dumps(record, indent=2, sort_keys=True))
    else:
        print(f"ct2-decision: answered {args.decision_id} -> {args.choice}")
    return 0


def cmd_format(args: argparse.Namespace) -> int:
    project_dir = Path(args.project_dir).resolve()
    ct2_dir = ensure_ct2(project_dir)
    found = find_record(ct2_dir, args.decision_id)
    if not found:
        print(f"ct2-decision: decision not found: {args.decision_id}", file=sys.stderr)
        return 1
    _path, record = found
    provider = args.provider or record.get("provider")
    payload = provider_payload(record, str(provider))
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        if payload["provider"] == "codex":
            print(f"ct2-decision: {payload['method']} for {args.decision_id}")
        else:
            print(f"ct2-decision: {payload['tool']} for {args.decision_id}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Manage CT2 decision bridge records")
    sub = parser.add_subparsers(dest="command", required=True)

    ask = sub.add_parser("ask")
    ask.add_argument("--project-dir", default=".")
    ask.add_argument("--provider", required=True)
    ask.add_argument("--role", required=True)
    ask.add_argument("--ticket")
    ask.add_argument("--question", required=True)
    ask.add_argument("--option", action="append")
    ask.add_argument("--kind", default="clarification")
    ask.add_argument("--json", action="store_true")
    ask.set_defaults(func=cmd_ask)

    answer = sub.add_parser("answer")
    answer.add_argument("decision_id")
    answer.add_argument("--project-dir", default=".")
    answer.add_argument("--choice", required=True)
    answer.add_argument("--json", action="store_true")
    answer.set_defaults(func=cmd_answer)

    fmt = sub.add_parser("format")
    fmt.add_argument("decision_id")
    fmt.add_argument("--project-dir", default=".")
    fmt.add_argument("--provider", choices=("codex", "claude"))
    fmt.add_argument("--json", action="store_true")
    fmt.set_defaults(func=cmd_format)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
