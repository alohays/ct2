#!/usr/bin/env python3
"""Migrate a CT2 project from protocol 0.2 to 0.3."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from _ct2_migrate import run_migration


def main() -> int:
    parser = argparse.ArgumentParser(description="Migrate CT2 protocol 0.2 to 0.3")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        result = run_migration(Path(args.project_dir).resolve(), "0.2", "0.3", args.dry_run)
    except Exception as exc:
        print(f"ct2-migrate-0.2-0.3: error: {exc}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"ct2-migrate-0.2-0.3: {result['state']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
