#!/usr/bin/env python3
"""Create or update CT2 GitHub Issue column labels."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from _ct2_issue import all_column_labels, ensure_labels, integration_enabled
from _ct2_protocol import assert_compatible as assert_protocol_compatible
from _ct2_vao import ensure_ct2


def main() -> int:
    parser = argparse.ArgumentParser(description="Bootstrap CT2 GitHub Issue labels")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    project_dir = Path(args.project_dir).resolve()
    try:
        ct2_dir = ensure_ct2(project_dir)
        assert_protocol_compatible(project_dir)
        if not integration_enabled(ct2_dir):
            result = {"ok": True, "status": "disabled", "labels": []}
        else:
            ensure_labels(project_dir, ct2_dir)
            result = {"ok": True, "status": "bootstrapped", "labels": all_column_labels(ct2_dir)}
    except Exception as exc:
        print(f"ct2-issue-bootstrap-labels: {exc}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"ct2-issue-bootstrap-labels: {result['status']}")
        for label in result["labels"]:
            print(f"  {label}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
