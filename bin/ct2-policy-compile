#!/usr/bin/env python3
"""Compile CT2 policy guardrails into project-local provider artifacts."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from _ct2_vao import atomic_write_json, ensure_ct2, now, relative_to_project


def main() -> int:
    parser = argparse.ArgumentParser(description="Compile CT2 hook and validator policy metadata")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    project_dir = Path(args.project_dir).resolve()
    repo_dir = Path(__file__).resolve().parents[1]
    ct2_dir = ensure_ct2(project_dir)
    out_dir = ct2_dir / "runtime" / "provider-hooks"
    hooks_src = repo_dir / "claude-plugin" / "hooks" / "hooks.json"
    hook_scripts = sorted((repo_dir / "claude-plugin" / "hooks").glob("*.sh"))

    hooks = json.loads(hooks_src.read_text(encoding="utf-8"))
    validators = {
        "schema_version": "1",
        "generated_at": now(),
        "provider": "claude",
        "source": relative_to_project(repo_dir, hooks_src),
        "validators": [
            {
                "name": path.stem,
                "path": relative_to_project(repo_dir, path),
                "events": ["PreToolUse", "PostToolUse"],
                "authority": "defense-in-depth",
            }
            for path in hook_scripts
        ],
        "script_authority": "CT2 scripts remain authoritative when provider hooks are missing.",
    }
    report = {
        "schema_version": "1",
        "generated_at": validators["generated_at"],
        "provider_hooks": {
            "claude": ".ct2/runtime/provider-hooks/claude-hooks.json",
            "shell_validators": ".ct2/runtime/provider-hooks/shell-validators.json",
        },
        "validators": len(validators["validators"]),
    }

    atomic_write_json(ct2_dir, out_dir / "claude-hooks.json", hooks, "policy-hooks-")
    atomic_write_json(ct2_dir, out_dir / "shell-validators.json", validators, "policy-validators-")
    atomic_write_json(ct2_dir, out_dir / "compile-report.json", report, "policy-report-")

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print("CT2 Policy Compiler")
        print(f"  validators: {report['validators']}")
        print(f"  wrote: {out_dir}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
