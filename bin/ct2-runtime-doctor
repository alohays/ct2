#!/usr/bin/env python3
"""Probe local runtime capabilities and degraded paths for CT2."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

from _ct2_protocol import migration_command, status as protocol_status
from _ct2_vao import atomic_write_json, atomic_write_text, ensure_ct2, now


# Baseline pins gate on OBSERVED CAPABILITY, not the newest upstream release
# (spec/runtime-capabilities.md). Version numbers are observation-dated:
# Codex upstream stable was 0.137.0 (2026-06-04) at the 2026-06 radar survey
# (docs/agent-platform-feature-radar-2026-06.md).
#
# MIN_CODEX stays at 0.130.0 deliberately: 0.128.0 is the historical
# schema/capability floor (non-interactive exec, `features list` probing, the
# goals/app-server schema per spec/codex-runtime-contract.md), and 0.130.0 is
# the observation-verified enforced baseline at or above that floor (2026-05
# radar; README and spec re-pinned to it on 2026-06-10). The 0.136.0+ surfaces
# (`tools.experimental_request_user_input`, `app-server --stdio`,
# thread-resume) are optional enhancements with graceful fallbacks, and
# subagents TOML / multi-agent v2 (dogfood defaults through 0.137.0) ship no
# independent dual-reviewer and never carry CT2 state writes — none of them
# raise the floor.
MIN_CODEX = (0, 130, 0)
MIN_CLAUDE = (2, 1, 138)
# Claude Code dynamic workflows ship at v2.1.154+ (research preview); see
# docs/ct2-dynamic-workflow-strategy-2026-06.md. Hint threshold only, not a
# supported-version floor.
WORKFLOW_CLASS_CLAUDE = (2, 1, 154)


def run(cmd: list[str], cwd: Path, timeout: int = 10) -> dict[str, object]:
    try:
        proc = subprocess.run(
            cmd,
            cwd=str(cwd),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        return {
            "ok": proc.returncode == 0,
            "returncode": proc.returncode,
            "stdout": proc.stdout,
            "stderr": proc.stderr,
        }
    except Exception as exc:
        return {"ok": False, "returncode": None, "stdout": "", "stderr": str(exc)}


def which(cmd: str) -> str | None:
    if "/" in cmd:
        return cmd if Path(cmd).exists() and os.access(cmd, os.X_OK) else None
    return shutil.which(cmd)


def parse_version(text: str) -> tuple[int, int, int] | None:
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    if not match:
        return None
    return tuple(int(part) for part in match.groups())


def version_ok(found: tuple[int, int, int] | None, minimum: tuple[int, int, int]) -> bool:
    return found is not None and found >= minimum


def probe_workflow_class(claude: dict) -> dict:
    """Network-free hint for native dynamic-workflow (workflow-class) support.

    A shell probe cannot query a live runtime tool list, so this derives a
    capability hint from the claude CLI version signal and reports the
    detection method alongside it — never a guarantee. Absence or an
    unparseable version is a healthy serial-fallback state, never an error.
    """
    threshold = ".".join(str(part) for part in WORKFLOW_CLASS_CLAUDE)
    probe = {
        "state": "unknown-serial-fallback",
        "method": "none",
        "authority": "hint",
    }
    try:
        if not claude.get("available"):
            probe["method"] = "claude-cli-missing"
            return probe
        found = parse_version(str(claude.get("version") or ""))
        if found is None:
            probe["method"] = "claude-cli-version-unparseable"
            return probe
        if found >= WORKFLOW_CLASS_CLAUDE:
            probe["state"] = "available"
            probe["method"] = f"claude-cli-version>={threshold}"
        else:
            probe["state"] = "unavailable-serial-fallback"
            probe["method"] = f"claude-cli-version<{threshold}"
    except Exception:
        probe["state"] = "unknown-serial-fallback"
        probe["method"] = "probe-error"
    return probe


def probe_runtime(project_dir: Path, name: str, env_key: str, default_cmd: str, minimum: tuple[int, int, int]) -> dict:
    cmd = os.environ.get(env_key, default_cmd)
    path = which(cmd)
    result = {
        "cmd": cmd,
        "path": path,
        "available": bool(path),
        "version": None,
        "version_ok": False,
        "features": {},
    }
    if not path:
        return result
    version = run([cmd, "--version"], project_dir)
    if version["ok"]:
        text = str(version["stdout"]).strip()
        result["version"] = text
        result["version_ok"] = version_ok(parse_version(text), minimum)
    if name == "codex":
        features = run([cmd, "features", "list"], project_dir)
        if features["ok"]:
            parsed = {}
            for line in str(features["stdout"]).splitlines():
                parts = line.split()
                if len(parts) >= 3 and parts[-1] in {"true", "false"}:
                    parsed[parts[0]] = {"stage": " ".join(parts[1:-1]), "enabled": parts[-1] == "true"}
            result["features"] = parsed
    return result


def local_tools() -> dict:
    return {
        "python": {"available": True, "version": sys.version.split()[0]},
        "git": {"available": shutil.which("git") is not None, "path": shutil.which("git")},
    }


def protocol_report(project_dir: Path, ct2_dir: Path) -> dict:
    migrations = ct2_dir / ".migrations"
    backups = sorted(migrations.glob("*.tar.gz")) if migrations.is_dir() else []
    logs = sorted(migrations.glob("*.log")) if migrations.is_dir() else []
    try:
        result = protocol_status(project_dir)
        suggested = "none"
        if result.action == "migrate":
            suggested = migration_command(result.project_protocol, result.current_protocol)
        elif result.action == "upgrade-install":
            suggested = "upgrade CT2 install"
        return {
            "project_protocol": result.project_protocol,
            "current_protocol": result.current_protocol,
            "compatible": result.compatible,
            "status": "compatible" if result.compatible else result.action,
            "message": result.message,
            "suggested_action": suggested,
            "marker_missing": result.marker_missing,
            "last_migration": logs[-1].name if logs else None,
            "backups_available": len(backups),
        }
    except Exception as exc:
        return {
            "project_protocol": None,
            "current_protocol": None,
            "compatible": False,
            "status": "invalid",
            "message": str(exc),
            "suggested_action": "inspect .ct2/.protocol-version",
            "marker_missing": False,
            "last_migration": logs[-1].name if logs else None,
            "backups_available": len(backups),
        }


def degradation_lines(report: dict) -> list[str]:
    lines = []
    codex = report["runtimes"]["codex"]
    claude = report["runtimes"]["claude"]
    if not codex["available"]:
        lines.append("Codex CLI unavailable; Codex roles and lens-cx adapter are degraded.")
    elif not codex["version_ok"]:
        lines.append(f"Codex version below {report['minimum_versions']['codex']}; use advisory-only fallbacks.")
    if not claude["available"]:
        lines.append("Claude Code CLI unavailable; Claude helm/forge/lens-cc roles are degraded.")
    elif not claude["version_ok"]:
        lines.append(f"Claude Code version below {report['minimum_versions']['claude']}; hook support may be degraded.")
    if not report["local"]["git"]["available"]:
        lines.append("git unavailable; branch-per-ticket workflow is degraded.")
    protocol = report.get("protocol") if isinstance(report.get("protocol"), dict) else {}
    if protocol and not protocol.get("compatible"):
        lines.append(f"Protocol compatibility requires action: {protocol.get('message')}")
    if not lines:
        lines.append("No degraded runtime capabilities detected.")
    return lines


def codex_flags_markdown(report: dict) -> str:
    checked_at = report["checked_at"]
    codex = report["runtimes"]["codex"]
    features = codex.get("features") if isinstance(codex.get("features"), dict) else {}
    lines = ["# CT2 Codex Flags Actual", "", f"Checked: {checked_at}", ""]
    if not features:
        lines.append("No Codex feature flags were observable from the local runtime.")
    else:
        lines.extend(["| Feature | Stage | Enabled |", "|---|---|---|"])
        for key in sorted(features):
            item = features[key]
            lines.append(f"| `{key}` | {item.get('stage', '')} | {item.get('enabled')} |")
    lines.append("")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description="Probe CT2 runtime capabilities")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    project_dir = Path(args.project_dir).resolve()
    ct2_dir = ensure_ct2(project_dir)
    checked_at = now()
    report = {
        "schema_version": "1",
        "checked_at": checked_at,
        "project_dir": str(project_dir),
        "minimum_versions": {
            "codex": ".".join(str(part) for part in MIN_CODEX),
            "claude": ".".join(str(part) for part in MIN_CLAUDE),
        },
        "authority": {
            "ticket_state": ".ct2/ state directories",
            "runtime_state": "advisory only",
            "state_mutation": "CT2 scripts with atomic mv",
        },
        "protocol": protocol_report(project_dir, ct2_dir),
        "runtimes": {
            "codex": probe_runtime(project_dir, "codex", "CT2_CODEX_CMD", "codex", MIN_CODEX),
            "claude": probe_runtime(project_dir, "claude", "CT2_CLAUDE_CMD", "claude", MIN_CLAUDE),
        },
        "local": local_tools(),
    }
    report["workflow_class"] = probe_workflow_class(report["runtimes"]["claude"])
    report["degradations"] = degradation_lines(report)

    atomic_write_json(ct2_dir, ct2_dir / "runtime" / "capabilities.json", report, "runtime-doctor-")
    md = ["# CT2 Runtime Degradations", "", f"Checked: {checked_at}", ""]
    md.extend(f"- {line}" for line in report["degradations"])
    md.append("")
    atomic_write_text(ct2_dir, ct2_dir / "runtime" / "degradations.md", "\n".join(md), "runtime-degradations-")
    atomic_write_text(
        ct2_dir,
        ct2_dir / "runtime" / "codex-flags-actual.md",
        codex_flags_markdown(report),
        "runtime-codex-flags-",
    )

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print("CT2 Runtime Doctor")
        protocol = report["protocol"]
        print(
            "  Protocol: "
            f"{protocol['status']} project={protocol['project_protocol']} current={protocol['current_protocol']}"
        )
        if protocol["suggested_action"] != "none":
            print(f"  Protocol action: {protocol['suggested_action']}")
        print(f"  Codex:  {'available' if report['runtimes']['codex']['available'] else 'missing'} {report['runtimes']['codex'].get('version') or ''}")
        print(f"  Claude: {'available' if report['runtimes']['claude']['available'] else 'missing'} {report['runtimes']['claude'].get('version') or ''}")
        workflow = report["workflow_class"]
        print(f"  Workflow-class: {workflow['state']} (hint via {workflow['method']})")
        print(f"  Wrote:  {ct2_dir / 'runtime' / 'capabilities.json'}")
        if report["degradations"]:
            print("  Degradations:")
            for item in report["degradations"]:
                print(f"    - {item}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
