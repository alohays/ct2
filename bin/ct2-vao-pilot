#!/usr/bin/env python3
"""Run a local VAO phase-completion pilot and preserve evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

sys.dont_write_bytecode = True

from _ct2_vao import (
    STATE_DIRS,
    append_jsonl,
    atomic_write_json,
    atomic_write_text,
    ensure_ct2,
    new_id,
    now,
)


REPO_ROOT = Path(__file__).resolve().parents[1]
DONE_PILOT_IDS = tuple(str(raw_id) for raw_id in range(900, 920))
PLAN_PILOT_IDS = tuple(str(raw_id) for raw_id in range(930, 935))


def pilot_generated_paths(ct2_dir: Path) -> list[Path]:
    paths: list[Path] = []
    for ticket_id in DONE_PILOT_IDS:
        paths.extend(
            [
                ct2_dir / "done" / f"{ticket_id}-vao-pilot.md",
                ct2_dir / "plans" / f"{ticket_id}-r0.md",
                ct2_dir / "reviews" / f"{ticket_id}-cc-r0.md",
                ct2_dir / "reviews" / f"{ticket_id}-cx-r0.md",
                ct2_dir / "evidence" / "artifacts" / f"pilot-{ticket_id}.json",
                ct2_dir / "evidence" / "verifiers" / f"pilot-verify-{ticket_id}.json",
            ]
        )
    for ticket_id in PLAN_PILOT_IDS:
        paths.extend(
            [
                ct2_dir / "in-review" / f"{ticket_id}-vao-pilot.md",
                ct2_dir / "plans" / f"{ticket_id}-r0.md",
                ct2_dir / "reviews" / f"{ticket_id}-cc-r0.md",
                ct2_dir / "reviews" / f"{ticket_id}-cx-r0.md",
            ]
        )
    return paths


def existing_ticket_count(ct2_dir: Path) -> int:
    return sum(1 for state in STATE_DIRS for _path in (ct2_dir / state).glob("*.md"))


def guard_existing_project(ct2_dir: Path, allow_existing_project: bool) -> None:
    collisions = [path for path in pilot_generated_paths(ct2_dir) if path.exists()]
    if allow_existing_project:
        if collisions:
            raise SystemExit(f"ct2-vao-pilot: refusing to overwrite generated pilot paths: {collisions[0]}")
        return
    if existing_ticket_count(ct2_dir) or collisions:
        detail = f"; first collision: {collisions[0]}" if collisions else ""
        raise SystemExit(f"ct2-vao-pilot: refusing to seed an existing .ct2 project without --allow-existing-project{detail}")


def run_step(
    project_dir: Path,
    name: str,
    cmd: list[str],
    env: dict[str, str] | None = None,
    expected_returncodes: tuple[int, ...] = (0,),
) -> dict[str, Any]:
    run_env = os.environ.copy()
    run_env["PYTHONDONTWRITEBYTECODE"] = "1"
    if env:
        run_env.update(env)
        run_env["PYTHONDONTWRITEBYTECODE"] = "1"
    proc = subprocess.run(
        [str(part) for part in cmd],
        cwd=str(project_dir),
        env=run_env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=120,
        check=False,
    )
    return {
        "name": name,
        "command": [str(part) for part in cmd],
        "returncode": proc.returncode,
        "ok": proc.returncode in expected_returncodes,
        "expected_returncodes": list(expected_returncodes),
        "stdout_tail": proc.stdout[-50000:],
        "stderr_tail": proc.stderr[-5000:],
    }


def ticket_text(ticket_id: str, status: str, title: str) -> str:
    return f"""---
id: "{ticket_id}"
title: "{title}"
status: {status}
priority: medium
created: 2026-05-01T00:00:00Z
sealed: 2026-05-01T00:10:00Z
updated: 2026-05-01T01:00:00Z
branch: null
pr: null
review-round: 0
estimated-scope: small
touched-files:
  - README.md
review-status:
  lens-claude:
    status: approved
    sidecar: reviews/{ticket_id}-cc-r0.md
  lens-codex:
    status: approved
    sidecar: reviews/{ticket_id}-cx-r0.md
verdict: approved
---

## Requirements
- [x] Exercise Verified Autonomy OS pilot evidence.

## Constraints
- No external packages.

## Context
Local VAO phase-completion pilot ticket generated by `ct2-vao-pilot`.

## Acceptance Criteria
- [x] Ticket has plan, dual sidecars, and evidence claim.
"""


def sidecar_text(ticket_id: str, reviewer: str) -> str:
    return f"""---
ticket: "{ticket_id}"
reviewer: {reviewer}
round: 0
verdict: approved
timestamp: 2026-05-01T01:00:00Z
---

## Summary
Approved local VAO pilot fixture.

## Acceptance Criteria Check
- [x] Ticket has plan, dual sidecars, and evidence claim.

## Issues Found
(none)

## Recommendation
approved - pilot evidence is present.
"""


def plan_text(ticket_id: str) -> str:
    return f"""# Plan {ticket_id}

- Map acceptance criteria to ticket evidence.
- Run verifier commands before completion.
- Preserve command/evidence ids for audit.
"""


def write_pilot_ticket(ct2_dir: Path, state: str, ticket_id: str, title: str) -> None:
    atomic_write_text(ct2_dir, ct2_dir / state / f"{ticket_id}-vao-pilot.md", ticket_text(ticket_id, state, title), "pilot-ticket-")
    atomic_write_text(ct2_dir, ct2_dir / "plans" / f"{ticket_id}-r0.md", plan_text(ticket_id), "pilot-plan-")
    atomic_write_text(ct2_dir, ct2_dir / "reviews" / f"{ticket_id}-cc-r0.md", sidecar_text(ticket_id, "ct2-lens-cc"), "pilot-sidecar-")
    atomic_write_text(ct2_dir, ct2_dir / "reviews" / f"{ticket_id}-cx-r0.md", sidecar_text(ticket_id, "ct2-lens-cx"), "pilot-sidecar-")


def seed_done_tickets(project_dir: Path, ct2_dir: Path) -> None:
    for ticket_id in DONE_PILOT_IDS:
        write_pilot_ticket(ct2_dir, "done", ticket_id, f"VAO baseline pilot {ticket_id}")
        evidence_id = f"pilot-{ticket_id}"
        artifact_path = ct2_dir / "evidence" / "artifacts" / f"{evidence_id}.json"
        atomic_write_json(
            ct2_dir,
            artifact_path,
            {
                "id": evidence_id,
                "schema_version": "1",
                "ticket": ticket_id,
                "kind": "artifact",
                "summary": "Pilot done-ticket evidence artifact",
                "ok": True,
            },
            "pilot-evidence-",
        )
        append_jsonl(
            ct2_dir,
            ct2_dir / "evidence" / "claims.jsonl",
            {
                "id": evidence_id,
                "timestamp": now(),
                "ticket": ticket_id,
                "kind": "artifact",
                "verifier": "ct2-vao-pilot",
                "ok": True,
                "path": str(artifact_path.relative_to(project_dir)),
                "summary": "Pilot done-ticket evidence artifact",
            },
        )
        verifier_id = f"pilot-verify-{ticket_id}"
        verifier_path = ct2_dir / "evidence" / "verifiers" / f"{verifier_id}.json"
        atomic_write_json(
            ct2_dir,
            verifier_path,
            {
                "id": verifier_id,
                "schema_version": "1",
                "ticket": ticket_id,
                "kind": "verifier",
                "name": "ct2-vao-pilot",
                "exit_code": 0,
                "summary": "Pilot done-ticket verifier evidence",
                "ok": True,
            },
            "pilot-verifier-",
        )
        append_jsonl(
            ct2_dir,
            ct2_dir / "evidence" / "claims.jsonl",
            {
                "id": verifier_id,
                "timestamp": now(),
                "ticket": ticket_id,
                "kind": "verifier",
                "verifier": "ct2-vao-pilot",
                "ok": True,
                "path": str(verifier_path.relative_to(project_dir)),
                "summary": "Pilot done-ticket verifier evidence",
            },
        )


def seed_plan_first_tickets(ct2_dir: Path) -> list[str]:
    ticket_ids = []
    for ticket_id in PLAN_PILOT_IDS:
        write_pilot_ticket(ct2_dir, "in-review", ticket_id, f"VAO plan-first pilot {ticket_id}")
        ticket_ids.append(ticket_id)
    comparison = {
        "schema_version": "1",
        "ticket_ids": ticket_ids,
        "plan_first_tickets": len(ticket_ids),
        "comparison": "All pilot tickets entered in-review with plan evidence before review.",
    }
    atomic_write_json(
        ct2_dir,
        ct2_dir / "evidence" / "artifacts" / "plan-first-review-comparison.json",
        comparison,
        "pilot-plan-comparison-",
    )
    return ticket_ids


def ticket_snapshot(ct2_dir: Path) -> dict[str, str]:
    snapshot: dict[str, str] = {}
    for state in STATE_DIRS:
        for path in sorted((ct2_dir / state).glob("*.md")):
            snapshot[str(path.relative_to(ct2_dir))] = hashlib.sha256(path.read_bytes()).hexdigest()
    return snapshot


def count_events(ct2_dir: Path, event_type: str) -> int:
    path = ct2_dir / "telemetry" / "events.jsonl"
    if not path.exists():
        return 0
    count = 0
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            if json.loads(line).get("type") == event_type:
                count += 1
        except json.JSONDecodeError:
            continue
    return count


def latest_json(stdout: str) -> dict[str, Any]:
    return json.loads(stdout)


def write_markdown_report(ct2_dir: Path, report: dict[str, Any], report_file: Path) -> None:
    rows = []
    for key, value in report["phase_status"].items():
        rows.append(f"| {key} | {'complete' if value else 'incomplete'} |")
    lines = [
        "# CT2 VAO Phase Completion Pilot Report",
        "",
        f"Date: {report['generated_at']}",
        f"Run ID: `{report['id']}`",
        "",
        "## Result",
        "",
        f"Overall complete: `{str(report['complete']).lower()}`",
        "",
        "| Phase / Requirement | Status |",
        "|---|---|",
        *rows,
        "",
        "## Evidence",
        "",
        f"- Runtime capabilities: `{report['artifacts']['capabilities']}`",
        f"- Baseline: `{report['artifacts']['baseline']}`",
        f"- Cost events: `{report['metrics']['cost_events']}`",
        f"- Done-ticket baseline sample: `{report['metrics']['done_tickets']}`",
        f"- Plan-audited tickets: `{report['metrics']['plan_tickets_checked']}`",
        f"- Role eval cases: `{report['metrics']['role_eval_cases']}`",
        f"- Advisory notifications: `{report['metrics']['advisory_notifications']}`",
        f"- Ticket state unchanged by bridge: `{str(report['metrics']['ticket_state_unchanged']).lower()}`",
        f"- Evidence kinds: `{', '.join(report['metrics']['evidence_kinds'])}`",
        "",
        "## Command Results",
        "",
    ]
    for step in report["steps"]:
        lines.append(f"- `{step['name']}`: returncode `{step['returncode']}`")
    lines.append("")
    atomic_write_text(ct2_dir, report_file, "\n".join(lines), "pilot-report-")


def main() -> int:
    parser = argparse.ArgumentParser(description="Run a local VAO phase-completion pilot")
    parser.add_argument("--project-dir")
    parser.add_argument("--allow-existing-project", action="store_true")
    parser.add_argument("--report-file")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    if args.project_dir:
        project_dir = Path(args.project_dir).resolve()
        existing_ct2 = (project_dir / ".ct2").exists()
    else:
        project_dir = Path(tempfile.mkdtemp(prefix="ct2-vao-pilot-")).resolve()
        existing_ct2 = False
    init_cmd = ["bash", REPO_ROOT / "bin" / "ct2-init", "--repair", project_dir]
    steps = [run_step(project_dir if project_dir.exists() else REPO_ROOT, "ct2-init --repair", init_cmd)]
    ct2_dir = ensure_ct2(project_dir)
    if existing_ct2:
        try:
            guard_existing_project(ct2_dir, args.allow_existing_project)
        except SystemExit as exc:
            if args.json:
                print(json.dumps({"complete": False, "error": str(exc)}, indent=2, sort_keys=True))
            print(str(exc), file=sys.stderr)
            return 2

    seed_done_tickets(project_dir, ct2_dir)
    plan_first_ticket_ids = seed_plan_first_tickets(ct2_dir)

    fake_screenshot = ct2_dir / "evidence" / "artifacts" / "vao-pilot-screenshot.txt"
    atomic_write_text(ct2_dir, fake_screenshot, "VAO pilot screenshot placeholder\n", "pilot-screenshot-")

    for idx, role in enumerate(("ct2-forge", "ct2-lens-cc", "ct2-lens-cx", "ct2-helm", "ct2-forge"), start=1):
        env = os.environ.copy()
        env["CT2_COST_USD"] = f"0.0{idx}"
        env["CT2_INPUT_TOKENS"] = str(100 * idx)
        env["CT2_OUTPUT_TOKENS"] = str(25 * idx)
        steps.append(
            run_step(
                project_dir,
                f"ct2-role-run {role}",
                [
                    sys.executable,
                    REPO_ROOT / "bin" / "ct2-role-run",
                    "--project-dir",
                    project_dir,
                    "--role",
                    role,
                    "--ticket",
                    plan_first_ticket_ids[(idx - 1) % len(plan_first_ticket_ids)],
                    "--goal",
                    "vao-phase-pilot",
                    "--",
                    sys.executable,
                    "-c",
                    "print('vao pilot role run')",
                ],
                env=env,
            )
        )

    steps.extend(
        [
            run_step(project_dir, "ct2-runtime-doctor", [sys.executable, REPO_ROOT / "bin" / "ct2-runtime-doctor", "--json", project_dir]),
            run_step(project_dir, "ct2-policy-compile", [sys.executable, REPO_ROOT / "bin" / "ct2-policy-compile", "--json", project_dir]),
            run_step(
                project_dir,
                "ct2-evidence screenshot",
                [
                    sys.executable,
                    REPO_ROOT / "bin" / "ct2-evidence",
                    "screenshot",
                    "--project-dir",
                    project_dir,
                    "--ticket",
                    "930",
                    "--path",
                    str(fake_screenshot.relative_to(project_dir)),
                    "--summary",
                    "Pilot screenshot evidence id",
                    "--json",
                ],
            ),
            run_step(
                project_dir,
                "ct2-evidence verifier",
                [
                    sys.executable,
                    REPO_ROOT / "bin" / "ct2-evidence",
                    "verifier",
                    "--project-dir",
                    project_dir,
                    "--ticket",
                    "930",
                    "--name",
                    "ct2-vao-pilot",
                    "--exit-code",
                    "0",
                    "--summary",
                    "Pilot verifier evidence id",
                    "--json",
                ],
            ),
            run_step(
                project_dir,
                "ct2-evidence hook-event",
                [
                    sys.executable,
                    REPO_ROOT / "bin" / "ct2-evidence",
                    "hook-event",
                    "--project-dir",
                    project_dir,
                    "--ticket",
                    "930",
                    "--hook",
                    "PreToolUse",
                    "--event",
                    "allowed",
                    "--summary",
                    "Pilot hook event evidence id",
                    "--json",
                ],
            ),
        ]
    )

    atomic_write_json(
        ct2_dir,
        ct2_dir / "watchers" / "vao-pilot.json",
        {
            "schema_version": "1",
            "id": "vao-pilot",
            "mode": "notify-only",
            "source": "local-pilot",
            "to": "ct2-helm",
            "ticket": "930",
        },
        "pilot-watcher-",
    )
    before_notify = ticket_snapshot(ct2_dir)
    for idx in range(5):
        steps.append(
            run_step(
                project_dir,
                f"ct2-bridge notify {idx + 1}",
                [
                    sys.executable,
                    REPO_ROOT / "bin" / "ct2-bridge",
                    "notify",
                    "--project-dir",
                    project_dir,
                    "--source",
                    "local-pilot",
                    "--to",
                    "ct2-helm",
                    "--ticket",
                    "930",
                    "--subject",
                    f"VAO pilot advisory {idx + 1}",
                    "--body",
                    "Notify-only advisory pilot event.",
                    "--json",
                ],
            )
        )
    after_notify = ticket_snapshot(ct2_dir)

    claude_ask = run_step(
        project_dir,
        "ct2-decision ask claude",
        [
            sys.executable,
            REPO_ROOT / "bin" / "ct2-decision",
            "ask",
            "--project-dir",
            project_dir,
            "--provider",
            "claude",
            "--role",
            "ct2-helm",
            "--ticket",
            "930",
            "--question",
            "Approve VAO pilot decision adapter?",
            "--option",
            "approve",
            "--option",
            "decline",
            "--json",
        ],
    )
    steps.append(claude_ask)
    if claude_ask["ok"]:
        decision_id = latest_json(claude_ask["stdout_tail"])["id"]
        steps.append(
            run_step(
                project_dir,
                "ct2-decision format claude",
                [sys.executable, REPO_ROOT / "bin" / "ct2-decision", "format", decision_id, "--project-dir", project_dir, "--provider", "claude", "--json"],
            )
        )
        steps.append(
            run_step(
                project_dir,
                "ct2-decision format codex",
                [sys.executable, REPO_ROOT / "bin" / "ct2-decision", "format", decision_id, "--project-dir", project_dir, "--provider", "codex", "--json"],
            )
        )
        steps.append(
            run_step(
                project_dir,
                "ct2-decision answer",
                [sys.executable, REPO_ROOT / "bin" / "ct2-decision", "answer", decision_id, "--project-dir", project_dir, "--choice", "approve", "--json"],
            )
        )

    regression_role = ct2_dir / "runtime" / "artifacts" / "regressed-forge-role.md"
    atomic_write_text(
        ct2_dir,
        regression_role,
        "# Regressed Forge Role\n\nThis intentionally omits the required plan evidence language.\n",
        "pilot-regression-role-",
    )

    steps.extend(
        [
            run_step(project_dir, "ct2-role-eval", [sys.executable, REPO_ROOT / "bin" / "ct2-role-eval", "--json", project_dir]),
            run_step(
                project_dir,
                "ct2-role-eval intentional regression",
                [
                    sys.executable,
                    REPO_ROOT / "bin" / "ct2-role-eval",
                    "--json",
                    "--role",
                    "ct2-forge",
                    "--target-override",
                    f"ct2-forge={regression_role}",
                    project_dir,
                ],
                expected_returncodes=(1,),
            ),
            run_step(project_dir, "ct2-plan-audit", [sys.executable, REPO_ROOT / "bin" / "ct2-plan-audit", "--json", project_dir]),
            run_step(project_dir, "ct2-cost", [sys.executable, REPO_ROOT / "bin" / "ct2-cost", "--json", project_dir]),
            run_step(project_dir, "ct2-baseline", [sys.executable, REPO_ROOT / "bin" / "ct2-baseline", "--json", project_dir]),
        ]
    )

    baseline = json.loads((ct2_dir / "telemetry" / "baseline-2026-05.json").read_text(encoding="utf-8"))
    plan_report = latest_json(next(step for step in steps if step["name"] == "ct2-plan-audit")["stdout_tail"])
    role_eval = latest_json(next(step for step in steps if step["name"] == "ct2-role-eval")["stdout_tail"])
    cost_report = latest_json(next(step for step in steps if step["name"] == "ct2-cost")["stdout_tail"])
    claims = []
    for line in (ct2_dir / "evidence" / "claims.jsonl").read_text(encoding="utf-8").splitlines():
        if line.strip():
            claims.append(json.loads(line))
    evidence_kinds = sorted({str(claim.get("kind")) for claim in claims})
    advisory_count = count_events(ct2_dir, "advisory_notification")
    ticket_state_unchanged = before_notify == after_notify

    phase_status = {
        "phase0_registry_baseline": (ct2_dir / "runtime" / "capabilities.json").exists()
        and (ct2_dir / "telemetry" / "baseline-2026-05.json").exists(),
        "bet1_cost_telemetry": cost_report["events"] >= 5,
        "bet2_plan_first_pilot": plan_report["complete"] and len(plan_first_ticket_ids) == 5,
        "bet4_role_eval_regression_harness": bool(role_eval["complete"])
        and role_eval["case_count"] >= 5
        and any(step["name"] == "ct2-role-eval intentional regression" and step["ok"] for step in steps),
        "bet3_advisory_bridge_pilot": advisory_count >= 5 and ticket_state_unchanged,
        "bet5_native_mirror_spike": (REPO_ROOT / "docs" / "ct2-native-task-mirror-spike-2026-05.md").exists(),
        "week6_scorecard_report": baseline["scorecard"]["trust"]["status"] == "measured",
        "decision_bridge_provider_adapters": any(step["name"] == "ct2-decision format claude" and step["ok"] for step in steps)
        and any(step["name"] == "ct2-decision format codex" and step["ok"] for step in steps),
        "evidence_graph_extended_kinds": {"artifact", "screenshot", "verifier", "hook-event"}.issubset(evidence_kinds),
    }

    report = {
        "schema_version": "1",
        "id": new_id("vao-pilot"),
        "generated_at": now(),
        "complete": all(phase_status.values()) and all(step["ok"] for step in steps),
        "project_dir": str(project_dir),
        "phase_status": phase_status,
        "metrics": {
            "done_tickets": baseline["inputs"]["done_tickets"],
            "trust_status": baseline["scorecard"]["trust"]["status"],
            "evidence_status": baseline["scorecard"]["evidence"]["status"],
            "cost_events": cost_report["events"],
            "plan_tickets_checked": plan_report["tickets_checked"],
            "role_eval_cases": role_eval["case_count"],
            "advisory_notifications": advisory_count,
            "ticket_state_unchanged": ticket_state_unchanged,
            "evidence_kinds": evidence_kinds,
        },
        "artifacts": {
            "capabilities": ".ct2/runtime/capabilities.json",
            "baseline": ".ct2/telemetry/baseline-2026-05.json",
            "cost": ".ct2/telemetry/cost.jsonl",
            "role_eval_results": ".ct2/evals/results.jsonl",
            "plan_comparison": ".ct2/evidence/artifacts/plan-first-review-comparison.json",
            "watcher": ".ct2/watchers/vao-pilot.json",
        },
        "steps": steps,
    }
    pilot_json = ct2_dir / "runtime" / "artifacts" / f"{report['id']}.json"
    atomic_write_json(ct2_dir, pilot_json, report, "pilot-report-json-")
    if args.report_file:
        report_file = Path(args.report_file)
        if not report_file.is_absolute():
            report_file = project_dir / report_file
        write_markdown_report(ct2_dir, report, report_file)
        report["report_file"] = str(report_file)

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print("CT2 VAO Phase Pilot")
        print(f"  complete: {report['complete']}")
        print(f"  artifact: {pilot_json}")
        if args.report_file:
            print(f"  report: {report['report_file']}")
    return 0 if report["complete"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
