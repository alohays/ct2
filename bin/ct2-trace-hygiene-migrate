#!/usr/bin/env python3
"""Switch a project's host-repo trace hygiene preset."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

from _ct2_protocol import assert_compatible as assert_protocol_compatible
from _ct2_vao import atomic_write_text, ensure_ct2


CLEAN_BLOCK = """trace_hygiene:
  preset: clean
  branch_naming: title-slug
  branch_prefix_pattern: "{type}/{title-slug}"
  commit_scope_style: minimal
  commit_trailer_style: minimal
  pr_body_footer: none
  pr_body_ticket_link: hidden-html
"""

LEGACY_BLOCK = "trace_hygiene: { preset: legacy-branded }\n"


def remove_trace_hygiene(text: str) -> str:
    lines = text.splitlines()
    result: list[str] = []
    index = 0
    while index < len(lines):
        line = lines[index]
        if re.match(r"^trace_hygiene:\s*", line):
            index += 1
            while index < len(lines):
                nxt = lines[index]
                if nxt.strip() and re.match(r"^[A-Za-z0-9_-]+:", nxt):
                    break
                if nxt.strip() and not nxt.startswith((" ", "\t", "#")):
                    break
                index += 1
            continue
        result.append(line)
        index += 1
    return "\n".join(result).rstrip() + "\n"


def migrate(project_dir: Path, preset: str) -> dict[str, object]:
    ct2_dir = ensure_ct2(project_dir)
    assert_protocol_compatible(project_dir)
    harness = ct2_dir / "config" / "harness.yaml"
    text = harness.read_text(encoding="utf-8")
    block = CLEAN_BLOCK if preset == "clean" else LEGACY_BLOCK
    updated = remove_trace_hygiene(text) + "\n" + block
    atomic_write_text(ct2_dir, harness, updated, "trace-hygiene-")
    return {"project_dir": str(project_dir), "preset": preset, "path": ".ct2/config/harness.yaml"}


def main() -> int:
    parser = argparse.ArgumentParser(description="Switch CT2 host-repo trace hygiene preset")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--preset", choices=("clean", "legacy-branded"), default="clean")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        result = migrate(Path(args.project_dir).resolve(), args.preset)
    except Exception as exc:
        print(f"ct2-trace-hygiene-migrate: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"ct2-trace-hygiene-migrate: preset={result['preset']} path={result['path']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
