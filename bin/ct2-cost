#!/usr/bin/env python3
"""Summarize CT2 role cost telemetry."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

from _ct2_vao import ensure_ct2, read_fanout_records, read_jsonl, now


def fanout_summary(records: list[dict]) -> dict:
    agent_counts = [int(row["agent_count"]) for row in records if isinstance(row.get("agent_count"), (int, float))]
    widths = [row["fanout_width"] for row in records if isinstance(row.get("fanout_width"), (int, float))]
    return {
        "advisory": True,
        "runs": len(records),
        "agent_count_total": sum(agent_counts),
        "fanout_width_max": max(widths) if widths else None,
    }


def summarize(rows: list[dict]) -> dict:
    clean = [row for row in rows if "_invalid" not in row]
    roles: dict[str, dict] = {}
    for row in clean:
        role = str(row.get("role") or "unknown")
        bucket = roles.setdefault(
            role,
            {"events": 0, "total_usd": 0.0, "duration_ms": 0, "input_tokens": 0, "output_tokens": 0, "failures": 0},
        )
        bucket["events"] += 1
        bucket["total_usd"] = round(bucket["total_usd"] + float(row.get("usd") or 0), 6)
        bucket["duration_ms"] += int(row.get("duration_ms") or 0)
        bucket["input_tokens"] += int(row.get("input_tokens") or 0)
        bucket["output_tokens"] += int(row.get("output_tokens") or 0)
        if int(row.get("exit_code") or 0) != 0:
            bucket["failures"] += 1
    return {
        "schema_version": "1",
        "generated_at": now(),
        "events": len(clean),
        "total_usd": round(sum(float(row.get("usd") or 0) for row in clean), 6),
        "total_duration_ms": sum(int(row.get("duration_ms") or 0) for row in clean),
        "roles": roles,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Summarize CT2 cost telemetry")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    project_dir = Path(args.project_dir).resolve()
    ct2_dir = ensure_ct2(project_dir)
    report = summarize(read_jsonl(ct2_dir / "telemetry" / "cost.jsonl"))
    fanout_records = read_fanout_records(ct2_dir)
    if fanout_records:
        report["fanout"] = fanout_summary(fanout_records)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print("CT2 Cost")
        print(f"  events: {report['events']}")
        print(f"  total_usd: {report['total_usd']}")
        for role, bucket in report["roles"].items():
            print(f"  {role}: events={bucket['events']} usd={bucket['total_usd']} failures={bucket['failures']}")
        fanout = report.get("fanout")
        if fanout:
            print(
                f"  fanout (advisory): runs={fanout['runs']}"
                f" agents={fanout['agent_count_total']}"
                f" width_max={fanout['fanout_width_max']}"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
