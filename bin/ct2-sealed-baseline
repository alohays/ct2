#!/usr/bin/env python3
"""Write or check immutable CT2 sealed ticket baselines."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from _ct2_sealed_baseline import compare_ticket_to_snapshot, write_snapshot


def cmd_write(args: argparse.Namespace) -> int:
    write_snapshot(Path(args.ticket), Path(args.output))
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    ok, evidence = compare_ticket_to_snapshot(Path(args.ticket), Path(args.snapshot))
    if args.json:
        print(json.dumps({"ok": ok, "evidence": evidence}, indent=2, sort_keys=True))
    elif not ok:
        print(f"ct2-sealed-baseline: mismatch: {evidence}", file=sys.stderr)
    return 0 if ok else 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Manage CT2 sealed ticket baselines")
    sub = parser.add_subparsers(dest="command", required=True)

    write = sub.add_parser("write")
    write.add_argument("ticket")
    write.add_argument("output")
    write.set_defaults(func=cmd_write)

    check = sub.add_parser("check")
    check.add_argument("ticket")
    check.add_argument("snapshot")
    check.add_argument("--json", action="store_true")
    check.set_defaults(func=cmd_check)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
