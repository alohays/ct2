#!/usr/bin/env python3
"""Local CT2 protocol conformance verifier."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

from _ct2_sealed_baseline import baseline_status, sealed_snapshot_name


REQUIRED_SPECS = (
    "PROTOCOL.md",
    "directory-structure.md",
    "state-machine.md",
    "ticket-format.md",
    "review-protocol.md",
    "sidecar-format.md",
    "reconciler.md",
    "adapter-format.md",
    "conformance.md",
)
REQUIRED_ADAPTERS = (
    "adapters/claude/lens-cc.md",
    "adapters/claude/lens-cx.md",
    "adapters/codex/lens-cc.md",
    "adapters/codex/lens-cx.md",
)
REQUIRED_BINS = (
    "ct2-reconcile",
    "ct2-lens-cc",
    "ct2-lens-cx",
    "ct2-status",
    "ct2-init",
    "ct2-pickup",
    "ct2-inbox",
    "ct2-review-enter",
    "ct2-review-watchdog",
    "ct2-sidecar-publish",
    "ct2-duration-check",
    "ct2-sealed-baseline",
)
SEALED_BASELINE_STATES = ("backlog", "in-progress", "in-review", "rejected", "escalated", "done")
REQUIRED_SECTIONS = ("## Invocation", "## Objective", "## Required CT2 Effects", "## Stop Condition")
ROLE_DOC_GLOBS = (
    "adapters/**/*.md",
    "claude-plugin/skills/*/SKILL.md",
    "codex-plugin/skills/*/SKILL.md",
    "config/ct2-lens-*-role.md",
)
DONE_BYPASS_PATTERNS = (
    re.compile(r"\bclose\s+the\s+ticket\b[^\n]*\bmove\s+to\s+`?(?:\.ct2/)?done/?`?", re.IGNORECASE),
    re.compile(r"\bmove\b[^\n]*\bto\s+`?(?:\.ct2/)?done/?`?", re.IGNORECASE),
    re.compile(r"\bplace\b[^\n]*\b(?:into|in)\s+`?(?:\.ct2/)?done/?`?", re.IGNORECASE),
    re.compile(r"\bmove\s+to\s+`?(?:\.ct2/)?done/?`?\s+with\s+a\s+manual\s+override\b", re.IGNORECASE),
    re.compile(r"\bbypass(?:es)?\s+the\s+dual-approval\s+invariant\b", re.IGNORECASE),
    re.compile(r"\bmv\b[^\n]*\.ct2/(?:in-review|rejected|escalated)/[^\n]*\s+\.ct2/done/", re.IGNORECASE),
)
ALLOWED_GUARD_PATTERNS = (
    # Inline prohibition: a forbidding word immediately precedes the moving verb.
    re.compile(
        r"\b(?:do\s+not|don't|never|must\s+not|may\s+not|cannot|can't|should\s+not|shouldn't)\s+"
        r"(?:move|place|put|advance|transition|push|publish|finalize)\b"
        r"[^.\n]{0,120}\bdone\b",
        re.IGNORECASE,
    ),
    # Explicit reservation of done/ for the reconciler.
    re.compile(r"\bdone/?\b[^.\n]{0,80}\b(?:is|are|stays)\s+reserved\s+for\b", re.IGNORECASE),
    re.compile(r"\breserved\s+for\s+(?:ct2-reconcile|the\s+reconciler|reconciler)\b", re.IGNORECASE),
    re.compile(r"\bdone\s+remains\s+reachable\s+only\b", re.IGNORECASE),
    # "only through/via/by reconciler" or "only the reconciler ..."
    re.compile(r"\bonly\s+(?:through|via|by)\s+(?:ct2-reconcile|reconciler|dual[ -]approval)\b", re.IGNORECASE),
    re.compile(r"\bonly\s+the\s+reconciler\b", re.IGNORECASE),
    # Reconciler is the subject of the moving verb (descriptive prose).
    re.compile(r"\b(?:the\s+)?(?:ct2-)?reconciler\s+(?:moves|advances|publishes|transitions|finalizes|writes)\b", re.IGNORECASE),
    # Inline parenthetical clarification e.g. "(the reconciler handles this)".
    re.compile(r"\(\s*(?:the\s+)?reconciler\s+(?:handles|does|performs)\s+this\s*\)", re.IGNORECASE),
)
PROHIBITION_HEADER_RE = re.compile(
    r"^#{1,6}\s+(?:what\s+you\s+must\s+not|forbidden|never|don'?t\b|prohibitions?)\b",
    re.IGNORECASE,
)
PROHIBITION_BLOCK_OPEN_RE = re.compile(
    r'^<constraints\b[^>]*\bid\s*=\s*"prohibition[^"]*"',
    re.IGNORECASE,
)
CONSTRAINTS_OPEN_RE = re.compile(r"^<constraints\b", re.IGNORECASE)
CONSTRAINTS_CLOSE_RE = re.compile(r"^</constraints>", re.IGNORECASE)


def check(ok: bool, name: str, evidence: str) -> dict:
    return {"ok": ok, "name": name, "evidence": evidence}


def advisory(name: str, evidence: str) -> dict:
    return {"ok": True, "name": name, "evidence": evidence, "advisory": True}


def adapter_ok(path: Path) -> tuple[bool, str]:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return False, str(exc)
    missing = [section for section in REQUIRED_SECTIONS if section not in text]
    if missing:
        return False, f"missing {', '.join(missing)}"
    if "protocol:" not in text or "agent:" not in text or "role:" not in text:
        return False, "missing adapter frontmatter keys"
    if len(text) > 3000:
        return False, "adapter exceeds 3000 character verifier cap"
    return True, f"{len(text)} chars"


def role_docs_no_done_bypass(repo: Path) -> tuple[bool, str]:
    """Reject role-doc lines that direct an agent to move a ticket into done/.

    Each candidate line is checked against DONE_BYPASS_PATTERNS. A line is
    exempt only when at least one of these is true:

      1. it sits inside a prohibition section (header like
         ``## Forbidden Operations`` / ``## What You Must NOT Do`` or a
         ``<constraints id="prohibitions">`` XML-style block), OR
      2. it contains an inline guard phrase that explicitly forbids the
         bypass or attributes the move to the reconciler
         (``ALLOWED_GUARD_PATTERNS``).

    Loose keyword exemptions like merely mentioning ``reconciler`` or
    starting with ``Do not`` are intentionally NOT enough on their own —
    those allowed past variants like "Do not wait; move to done/ manually"
    and "If the reconciler is unavailable, move to done/ manually."
    """
    offenders = []
    paths = []
    for pattern in ROLE_DOC_GLOBS:
        paths.extend(repo.glob(pattern))
    for path in sorted(set(paths)):
        try:
            text = path.read_text(encoding="utf-8")
        except OSError as exc:
            offenders.append(f"{path.relative_to(repo)}: read failed: {exc}")
            continue
        in_prohibition_section = False
        for lineno, line in enumerate(text.splitlines(), 1):
            stripped = line.strip()
            # Section state transitions.
            if PROHIBITION_BLOCK_OPEN_RE.match(stripped):
                in_prohibition_section = True
                continue
            if CONSTRAINTS_OPEN_RE.match(stripped):
                # Any other <constraints id="..."> resets prohibition context.
                in_prohibition_section = False
                continue
            if CONSTRAINTS_CLOSE_RE.match(stripped):
                in_prohibition_section = False
                continue
            if stripped.startswith("#"):
                in_prohibition_section = bool(PROHIBITION_HEADER_RE.match(stripped))
                continue
            if in_prohibition_section:
                continue
            if any(regex.search(line) for regex in ALLOWED_GUARD_PATTERNS):
                continue
            if any(regex.search(line) for regex in DONE_BYPASS_PATTERNS):
                excerpt = line.strip()
                if len(excerpt) > 140:
                    excerpt = excerpt[:137] + "..."
                offenders.append(f"{path.relative_to(repo)}:{lineno}: {excerpt}")
    if offenders:
        return False, "; ".join(offenders)
    return True, "role docs reserve done/ for ct2-reconcile dual approval"


def main() -> int:
    parser = argparse.ArgumentParser(description="Verify local CT2 protocol artifacts")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--repo", default=Path(__file__).resolve().parents[1])
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--run-tests", action="store_true")
    parser.add_argument(
        "--strict-sealed-baseline",
        action="store_true",
        help="Fail if any governed ticket is missing its sealed baseline (default: advisory, drift still fatal)",
    )
    args = parser.parse_args()

    repo = Path(args.repo).resolve()
    project = Path(args.project_dir).resolve()
    results = []

    for name in REQUIRED_SPECS:
        path = repo / "spec" / name
        results.append(check(path.is_file(), f"spec:{name}", str(path)))
    for name in REQUIRED_BINS:
        path = repo / "bin" / name
        results.append(check(path.is_file(), f"bin:{name}", str(path)))
    for rel in REQUIRED_ADAPTERS:
        ok, evidence = adapter_ok(repo / rel)
        results.append(check(ok, f"adapter:{rel}", evidence))
    ok, evidence = role_docs_no_done_bypass(repo)
    results.append(check(ok, "protocol:no-manual-done-bypass", evidence))
    if (project / ".ct2").exists():
        for rel in ("in-review", "reviews", ".tmp", ".meta", "inbox/ct2-helm"):
            path = project / ".ct2" / rel
            results.append(check(path.is_dir(), f"project-dir:{rel}", str(path)))
        in_progress = sorted((project / ".ct2" / "in-progress").glob("*.md"))
        results.append(
            check(
                len(in_progress) <= 1,
                "kanban:single-in-progress",
                ", ".join(path.name for path in in_progress) if in_progress else "0 tickets",
            )
        )
        ct2_dir = project / ".ct2"
        for state in SEALED_BASELINE_STATES:
            for ticket in sorted((ct2_dir / state).glob("*.md")):
                snapshot = ct2_dir / "reviews" / sealed_snapshot_name(ticket)
                status, evidence = baseline_status(ticket, snapshot)
                name = f"sealed-baseline:{ticket.name}"
                evidence_json = json.dumps(evidence, sort_keys=True)
                if status == "ok":
                    results.append(check(True, name, evidence_json))
                elif status == "drift":
                    results.append(check(False, name, evidence_json))
                else:  # missing -- legacy ticket sealed before baseline snapshots existed
                    if args.strict_sealed_baseline:
                        results.append(check(False, name, evidence_json))
                    else:
                        results.append(
                            advisory(
                                name,
                                evidence_json
                                + " (run `ct2-sealed-baseline backfill` to migrate; pass --strict-sealed-baseline to fail)",
                            )
                        )

    if args.run_tests:
        proc = subprocess.run(
            [sys.executable, "-m", "unittest", "discover", "-s", "tests"],
            cwd=str(repo),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        results.append(check(proc.returncode == 0, "unittest", (proc.stdout + proc.stderr).strip()))

    report = {
        "repo": str(repo),
        "project_dir": str(project),
        "ok": all(item["ok"] for item in results),
        "checks": results,
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        for item in results:
            if item.get("advisory"):
                prefix = "WARN"
            elif item["ok"]:
                prefix = "ok"
            else:
                prefix = "FAIL"
            print(f"{prefix:<4} {item['name']} - {item['evidence']}")
    return 0 if report["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
