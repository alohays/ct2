#!/usr/bin/env bash
# ct2-seal — Validate and move a draft ticket to backlog.
# Usage: ct2-seal <ticket-id-or-filename>
#
# Accepts:
#   ct2-seal 003
#   ct2-seal 003-refactor-db-pool
#   ct2-seal 003-refactor-db-pool.md

set -euo pipefail

CT2_DIR="${PWD}/.ct2"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Locate .ct2/ ──────────────────────────────────────────────────────────────
if [[ ! -d "$CT2_DIR" ]]; then
  echo "ct2-seal: error — .ct2/ not found in ${PWD}" >&2
  echo "Run 'ct2-init' first." >&2
  exit 1
fi

if [[ $# -lt 1 ]]; then
  echo "Usage: ct2-seal <ticket-id-or-filename>" >&2
  exit 1
fi

ARG="$1"

# ── Resolve ticket filename ────────────────────────────────────────────────────
# Accept: "003", "003-refactor-db-pool", "003-refactor-db-pool.md"
find_ticket() {
  local draft_dir="${CT2_DIR}/draft"
  local arg="$1"

  # Exact match with .md
  if [[ -f "${draft_dir}/${arg}" ]]; then echo "${draft_dir}/${arg}"; return; fi
  # Add .md
  if [[ -f "${draft_dir}/${arg}.md" ]]; then echo "${draft_dir}/${arg}.md"; return; fi
  # Glob by numeric prefix
  local matches; matches=$(ls "${draft_dir}/${arg}"-*.md 2>/dev/null | head -1)
  if [[ -n "$matches" ]]; then echo "$matches"; return; fi
  # Already sealed? Check backlog/ and all downstream states.
  for state_dir in backlog in-progress in-review rejected escalated done; do
    local found
    found=$(ls "${CT2_DIR}/${state_dir}/${arg}"*.md 2>/dev/null | head -1)
    if [[ -n "$found" ]]; then
      echo "ct2-seal: warning — $(basename "$found" .md) is already in ${state_dir}/" >&2
      exit 2
    fi
  done
}

TICKET_PATH=$(find_ticket "$ARG")

if [[ -z "$TICKET_PATH" ]]; then
  echo "ct2-seal: error — ticket '${ARG}' not found in .ct2/draft/" >&2
  exit 1
fi

TICKET_FILE=$(basename "$TICKET_PATH")
TICKET_ID=$(echo "${TICKET_FILE%.md}" | grep -oE '^[0-9]+')
SNAPSHOT_DEST="${CT2_DIR}/reviews/${TICKET_ID}-sealed.md"
echo "ct2-seal: sealing ${TICKET_FILE}"

if [[ -z "$TICKET_ID" ]]; then
  echo "ct2-seal: error — cannot extract numeric ticket id from '${TICKET_FILE}'" >&2
  exit 1
fi

if [[ -e "$SNAPSHOT_DEST" ]]; then
  echo "ct2-seal: error — sealed baseline already exists: .ct2/reviews/${TICKET_ID}-sealed.md" >&2
  exit 1
fi

if ! python3 "${SCRIPT_DIR}/ct2-ticket-audit" --json --seal-gate --ticket "$TICKET_ID" "$PWD" >/dev/null; then
  python3 "${SCRIPT_DIR}/ct2-ticket-audit" --seal-gate --ticket "$TICKET_ID" "$PWD" || true
  echo "ct2-seal: ticket quality gate failed — edit the draft and retry" >&2
  exit 1
fi

# ── Validate required fields (Python for YAML parsing) ───────────────────────
python3 - "$TICKET_PATH" <<'PYEOF'
import sys, re

path = sys.argv[1]
content = open(path).read()

# Extract YAML frontmatter (between first pair of ---)
fm_match = re.match(r'^---\n(.*?)\n---', content, re.DOTALL)
if not fm_match:
    print("ct2-seal: error — no YAML frontmatter found", file=sys.stderr)
    sys.exit(1)

fm = fm_match.group(1)

errors = []

# Required frontmatter fields
for field in ('title', 'priority'):
    m = re.search(rf'^{field}:\s*"?(.+?)"?\s*$', fm, re.MULTILINE)
    if not m or not m.group(1).strip():
        errors.append(f"  - missing or empty field: {field}")

# touched-files must have at least one entry
if not re.search(r'^touched-files:\s*\n(\s+-\s+\S)', fm, re.MULTILINE):
    errors.append("  - touched-files: must have at least one entry")

# Body must contain ## Acceptance Criteria with at least one checkbox
if '## Acceptance Criteria' not in content:
    errors.append("  - missing section: ## Acceptance Criteria")
else:
    ac_section = content.split('## Acceptance Criteria', 1)[1]
    if not re.search(r'- \[[ x]\]', ac_section):
        errors.append("  - ## Acceptance Criteria has no checklist items")

if errors:
    print("ct2-seal: validation failed — the following fields are required:", file=sys.stderr)
    for e in errors:
        print(e, file=sys.stderr)
    sys.exit(1)

print("OK")
PYEOF

VALIDATION=$?
if [[ $VALIDATION -ne 0 ]]; then
  exit 1
fi

# ── Atomic seal: state transition uses draft → backlog mv ────────────────────
SEALED_TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
DEST="${CT2_DIR}/backlog/${TICKET_FILE}"
TMP_UPDATED=$(mktemp "${CT2_DIR}/.tmp/seal-XXXXXX")
TMP_SNAPSHOT=$(mktemp "${CT2_DIR}/.tmp/sealed-baseline-XXXXXX.md")

cleanup_tmp() {
  [[ -n "${TMP_UPDATED:-}" && -f "$TMP_UPDATED" ]] && rm -f "$TMP_UPDATED"
  [[ -n "${TMP_SNAPSHOT:-}" && -f "$TMP_SNAPSHOT" ]] && rm -f "$TMP_SNAPSHOT"
}
trap cleanup_tmp EXIT

# Stage the rewritten ticket in .tmp/, then atomically install it in backlog/
# and remove the draft after the backlog file is confirmed present.
python3 - "$TICKET_PATH" "$TMP_UPDATED" "$SEALED_TS" <<'PYEOF'
import sys, re

source_path = sys.argv[1]
dest_path = sys.argv[2]
sealed_ts = sys.argv[3]
content = open(source_path).read()
match = re.match(r'^(---\n)(.*?)(\n---.*)$', content, re.DOTALL)
if not match:
    print("ct2-seal: error — no YAML frontmatter found", file=sys.stderr)
    sys.exit(1)
prefix, fm, rest = match.groups()

# Update status field
fm = re.sub(r'^(status:\s*).*$', r'\g<1>backlog', fm, count=1, flags=re.MULTILINE)
# Update sealed field (any value -> timestamp)
fm = re.sub(r'^(sealed:\s*).*$', rf'\g<1>{sealed_ts}', fm, count=1, flags=re.MULTILINE)
# Update updated field
updated_ts = sealed_ts
fm = re.sub(r'^(updated:\s*).*$', rf'\g<1>{updated_ts}', fm, count=1, flags=re.MULTILINE)

open(dest_path, 'w').write(prefix + fm + rest)
PYEOF

python3 "${SCRIPT_DIR}/ct2-sealed-baseline" write "$TICKET_PATH" "$TMP_SNAPSHOT"

mv -n "$TMP_SNAPSHOT" "$SNAPSHOT_DEST" 2>/dev/null
if [[ -f "$TMP_SNAPSHOT" ]]; then
  echo "ct2-seal: error — sealed baseline collision for ${TICKET_ID}" >&2
  exit 1
fi

# Atomic no-clobber install to backlog — verify tmp gone to confirm success
# because macOS mv -n returns 0 even when the move is suppressed.
mv -n "$TMP_UPDATED" "$DEST" 2>/dev/null
if [[ -f "$TMP_UPDATED" ]]; then
  rm -f "$SNAPSHOT_DEST"
  echo "ct2-seal: error — ${TICKET_FILE} already exists in backlog/. It was already sealed." >&2
  echo "  Run 'ct2-status' to check its current state." >&2
  exit 1
fi

TMP_UPDATED=""
TMP_SNAPSHOT=""
rm -f "$TICKET_PATH"
trap - EXIT

echo "✓ ${TICKET_FILE} sealed and moved to backlog/"
echo "  Run 'ct2-status' to verify, or start ct2-forge to begin processing."
