#!/usr/bin/env python3
"""Prepare and synchronize CT2 releases."""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

from _ct2_version import SemVer, read_version, repo_root_from_file, sync_derived_artifacts


CHANGELOG_HEADINGS = (
    "### Added\n",
    "### Changed\n",
    "### Fixed\n",
    "### Deprecated\n",
    "### Removed\n",
    "### Security\n",
)


def run(cmd: list[str], repo: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        cwd=str(repo),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def write_version(repo: Path, version: SemVer) -> None:
    (repo / "VERSION").write_text(f"{version}\n", encoding="utf-8")


def unreleased_stub() -> str:
    return "## [Unreleased]\n\n" + "\n".join(CHANGELOG_HEADINGS) + "\n"


def promote_changelog(repo: Path, version: SemVer) -> None:
    path = repo / "CHANGELOG.md"
    text = path.read_text(encoding="utf-8")
    marker = "## [Unreleased]"
    start = text.find(marker)
    if start < 0:
        raise RuntimeError("CHANGELOG.md is missing an [Unreleased] section")
    next_match = re.search(r"^## \[[^\]]+\]", text[start + len(marker) :], re.MULTILINE)
    if not next_match:
        raise RuntimeError("CHANGELOG.md has no release section after [Unreleased]")
    next_start = start + len(marker) + next_match.start()
    unreleased_body = text[start + len(marker) : next_start].strip()
    if not re.search(r"^\s*-\s+\S", unreleased_body, re.MULTILINE):
        unreleased_body = "### Changed\n\n- Release maintenance."
    released = f"## [{version}] - {date.today().isoformat()}\n\n{unreleased_body.strip()}\n\n"
    updated = text[:start] + unreleased_stub() + released + text[next_start:]
    path.write_text(updated, encoding="utf-8")


def ensure_git_repo(repo: Path) -> None:
    proc = run(["git", "rev-parse", "--is-inside-work-tree"], repo)
    if proc.returncode != 0:
        raise RuntimeError("ct2-release prepare must run inside a git repository")


def ensure_commit(repo: Path, version: SemVer) -> None:
    status = run(["git", "status", "--short"], repo)
    if status.returncode != 0:
        raise RuntimeError(status.stderr.strip() or "git status failed")
    if not status.stdout.strip():
        return
    add = run(["git", "add", "VERSION", "CHANGELOG.md", "install.sh", "claude-plugin/.claude-plugin/plugin.json", "codex-plugin/.codex-plugin/plugin.json"], repo)
    if add.returncode != 0:
        raise RuntimeError(add.stderr.strip() or "git add failed")
    message = (
        f"chore(release): prepare {version}\n\n"
        "Synchronize release metadata and promote the changelog.\n\n"
        "Constraint: VERSION remains the single source of truth\n"
        "Rejected: hand-edit plugin manifests separately | drift risk\n"
        "Confidence: high\n"
        "Scope-risk: narrow\n"
    )
    commit = run(
        [
            "git",
            "-c",
            "user.name=CT2 Release Bot",
            "-c",
            "user.email=ct2-release@example.invalid",
            "commit",
            "-m",
            message,
        ],
        repo,
    )
    if commit.returncode != 0:
        raise RuntimeError(commit.stderr.strip() or "git commit failed")


def command_sync(repo: Path) -> int:
    changed = sync_derived_artifacts(repo)
    version = read_version(repo)
    if changed:
        for path in changed:
            print(f"synced {path.relative_to(repo)} -> {version}")
    else:
        print(f"derived artifacts already match {version}")
    return 0


def command_prepare(repo: Path, bump: str) -> int:
    ensure_git_repo(repo)
    current = read_version(repo)
    next_version = current.bump(bump)
    write_version(repo, next_version)
    sync_derived_artifacts(repo)
    promote_changelog(repo, next_version)
    ensure_commit(repo, next_version)
    print(f"prepared {next_version}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Prepare and synchronize CT2 releases")
    parser.add_argument("--repo", default=repo_root_from_file(__file__), type=Path)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("sync", help="Synchronize derived artifacts from VERSION")
    prepare = sub.add_parser("prepare", help="Bump VERSION, promote CHANGELOG, sync manifests, and commit")
    prepare.add_argument("bump", choices=("patch", "minor", "major"))
    sub.add_parser("version", help="Print the canonical VERSION")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    repo = args.repo.resolve()
    try:
        if args.command == "sync":
            return command_sync(repo)
        if args.command == "prepare":
            return command_prepare(repo, args.bump)
        if args.command == "version":
            print(read_version(repo))
            return 0
    except Exception as exc:
        print(f"ct2-release: error: {exc}", file=sys.stderr)
        return 1
    parser.error("unknown command")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
