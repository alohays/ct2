#!/usr/bin/env python3
# ct2-status — Display current CT2 state for the project.
# Usage: ct2-status [project-dir]

import sys
import os
import re
import time
import json
import subprocess
from pathlib import Path
from datetime import datetime, timezone

from _ct2_protocol import status as get_protocol_status
from _ct2_version import git_short_sha, plugin_manifest_paths, read_plugin_version, read_version, repo_root_from_file

# ── Resolve flags / project dir ──────────────────────────────────────────────
doctor_mode = False
version_mode = False
positionals = []
for arg in sys.argv[1:]:
    if arg == "--doctor":
        doctor_mode = True
    elif arg == "--version":
        version_mode = True
    elif arg in ("-h", "--help"):
        print("Usage: ct2-status [--doctor] [--version] [project-dir]")
        sys.exit(0)
    else:
        positionals.append(arg)

project_dir = Path(positionals[0]).resolve() if positionals else Path.cwd()
ct2_dir = project_dir / ".ct2"
repo_root = repo_root_from_file(__file__)

if version_mode:
    version = read_version(repo_root)
    plugin_paths = plugin_manifest_paths(repo_root)
    claude_version = read_plugin_version(plugin_paths[0])
    codex_version = read_plugin_version(plugin_paths[1])
    print(f"ct2 {version}")
    print(f"install:         {repo_root}")
    print(f"commit:          {git_short_sha(repo_root)}")
    print(f"plugin (claude): {claude_version}")
    print(f"plugin (codex):  {codex_version}")
    print(f"protocol:        {version.protocol}")
    sys.exit(0)

if not ct2_dir.is_dir():
    print(f"ct2-status: .ct2/ not found in {project_dir}", file=sys.stderr)
    print("Run 'ct2-init' first.", file=sys.stderr)
    sys.exit(1)

SEP = "─" * 57
DEFAULT_MAX_REVIEW_DURATION_MIN = 240

def read_frontmatter(path: Path) -> dict:
    """Extract YAML frontmatter key-value pairs as strings."""
    try:
        content = path.read_text()
        m = re.match(r'^---\n(.*?)\n---', content, re.DOTALL)
        if not m:
            return {}
        fm = {}
        for line in m.group(1).splitlines():
            kv = re.match(r'^(\w[\w-]*):\s*(.+)$', line)
            if kv:
                val = kv.group(2).strip()
                # Strip inline YAML comments (e.g. "medium  # critical | high | ...")
                val = re.sub(r'\s+#.*$', '', val)
                fm[kv.group(1)] = val.strip('"')
        return fm
    except Exception:
        return {}

def age_str(path: Path) -> str:
    """Return human-readable age of a file."""
    try:
        mtime = path.stat().st_mtime
        elapsed = time.time() - mtime
        if elapsed < 90:
            return f"{int(elapsed)}s ago"
        elif elapsed < 3600:
            return f"{int(elapsed // 60)}m ago"
        else:
            return f"{elapsed / 3600:.1f}h ago"
    except Exception:
        return "unknown"

def elapsed_str(path: Path) -> str:
    """Return elapsed time since file was last modified (for in-progress)."""
    try:
        mtime = path.stat().st_mtime
        elapsed = time.time() - mtime
        if elapsed < 3600:
            return f"{int(elapsed // 60)}m elapsed"
        else:
            return f"{elapsed / 3600:.1f}h elapsed"
    except Exception:
        return ""

def config_int(key: str, default: int) -> int:
    try:
        cfg = (ct2_dir / "config" / "harness.yaml").read_text(encoding="utf-8")
        m = re.search(rf"^{re.escape(key)}:\s*(\d+)", cfg, re.MULTILINE)
        return int(m.group(1)) if m else default
    except Exception:
        return default

def review_age_min(ticket_path: Path) -> int | None:
    ticket_id = re.match(r'^(\d+)', ticket_path.stem)
    if not ticket_id:
        return None
    stamp = ct2_dir / ".meta" / f"{ticket_id.group(1)}.in-review"
    try:
        text = stamp.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    try:
        started = datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        try:
            started = stamp.stat().st_mtime
        except OSError:
            return None
    return int((time.time() - started) // 60)

def get_review_status(ticket_path: Path, reviews_dir: Path) -> str:
    """Return review status string for in-review tickets."""
    fm = read_frontmatter(ticket_path)
    ticket_id = re.match(r'^(\d+)', ticket_path.stem)
    if not ticket_id:
        return ""
    tid = ticket_id.group(1)
    round_num = fm.get("review-round", "0")

    cc_sidecar = reviews_dir / f"{tid}-cc-r{round_num}.md"
    cx_sidecar = reviews_dir / f"{tid}-cx-r{round_num}.md"

    def verdict(p: Path) -> str:
        if not p.exists():
            return "pending"
        v = read_frontmatter(p).get("verdict", "pending")
        return v

    cc_v = verdict(cc_sidecar)
    cx_v = verdict(cx_sidecar)
    age = review_age_min(ticket_path)
    age_text = f", age={age}m" if age is not None else ""
    return f"(r{round_num}: cc={cc_v}, cx={cx_v}{age_text})"

def list_state(state_dir: Path, state_label: str, extra_fn=None):
    """Print one Kanban row."""
    if not state_dir.is_dir():
        print(f"{state_label:<10} 0")
        return

    tickets = sorted(state_dir.glob("*.md"), key=lambda p: p.name)
    count = len(tickets)

    if count == 0:
        print(f"{state_label:<10} 0")
        return

    reviews_dir = ct2_dir / "reviews"
    for i, t in enumerate(tickets):
        fm = read_frontmatter(t)
        prio = fm.get("priority", "")
        prio_tag = f" [{prio}]" if prio and state_label in ("BACKLOG",) else ""

        extra = ""
        if extra_fn:
            extra = extra_fn(t)

        if i == 0:
            marker = "●" if state_label == "IN-PROG" else " "
            elapsed = f" [{elapsed_str(t)}]" if state_label == "IN-PROG" else ""
            review_info = f" {get_review_status(t, reviews_dir)}" if state_label == "IN-REVIEW" else ""
            print(f"{state_label:<10} {count} {marker} {t.name}{prio_tag}{elapsed}{review_info}")
        else:
            review_info = f" {get_review_status(t, reviews_dir)}" if state_label == "IN-REVIEW" else ""
            print(f"{'':>13}  {t.name}{prio_tag}{review_info}")

def workflow_summary():
    in_progress = list((ct2_dir / "in-progress").glob("*.md")) if (ct2_dir / "in-progress").is_dir() else []
    in_review = list((ct2_dir / "in-review").glob("*.md")) if (ct2_dir / "in-review").is_dir() else []
    pending_reviews = 0
    overdue_reviews = 0
    unstamped_reviews = 0
    max_review_min = config_int("max_review_duration_min", DEFAULT_MAX_REVIEW_DURATION_MIN)
    reviews_dir = ct2_dir / "reviews"
    for ticket in in_review:
        fm = read_frontmatter(ticket)
        ticket_id = re.match(r"^(\d+)", ticket.stem)
        if not ticket_id:
            continue
        tid = ticket_id.group(1)
        round_num = fm.get("review-round", "0")
        if not (reviews_dir / f"{tid}-cc-r{round_num}.md").exists():
            pending_reviews += 1
        if not (reviews_dir / f"{tid}-cx-r{round_num}.md").exists():
            pending_reviews += 1
        age = review_age_min(ticket)
        if age is None:
            if not (reviews_dir / f"{tid}-cc-r{round_num}.md").exists() or not (reviews_dir / f"{tid}-cx-r{round_num}.md").exists():
                unstamped_reviews += 1
        elif age >= max_review_min:
            if not (reviews_dir / f"{tid}-cc-r{round_num}.md").exists() or not (reviews_dir / f"{tid}-cx-r{round_num}.md").exists():
                overdue_reviews += 1
    canvas_open_dir = ct2_dir / "plans" / "canvas" / "open"
    open_canvases = len(list(canvas_open_dir.glob("*.canvas.html"))) if canvas_open_dir.is_dir() else 0
    print("WORKFLOW")
    print(f"  in-progress tickets: {len(in_progress)}")
    print(f"  in-review tickets:   {len(in_review)}")
    print(f"  missing sidecars:    {pending_reviews}")
    print(f"  overdue reviews:     {overdue_reviews}")
    print(f"  unstamped reviews:   {unstamped_reviews}")
    print(f"  open canvases:       {open_canvases}")

def protocol_summary():
    print("PROTOCOL")
    try:
        result = get_protocol_status(project_dir)
        print(f"  project: {result.project_protocol}")
        print(f"  install: {result.current_protocol}")
        print(f"  status:  {'compatible' if result.compatible else result.action}")
        if not result.compatible:
            print(f"  action:  {result.message}")
    except Exception as exc:
        print(f"  status:  invalid")
        print(f"  action:  inspect .ct2/.protocol-version ({exc})")

def github_summary():
    helper = repo_root / "bin" / "ct2-issue-reconcile"
    if not helper.exists():
        return
    proc = subprocess.run(
        [sys.executable, str(helper), "--json", str(project_dir)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    print("GITHUB")
    if proc.returncode == 1:
        print(f"  issue mirror: unavailable ({proc.stderr.strip() or 'error'})")
        return
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        print("  issue mirror: unavailable (invalid helper output)")
        return
    status = data.get("status", "?")
    findings = data.get("findings") if isinstance(data.get("findings"), list) else []
    print(f"  issue mirror: {status}, drift={len(findings)}")
    for finding in findings[:3]:
        print(f"    - {finding.get('ticket')} issue #{finding.get('issue')}: {finding.get('kind')}")
    if len(findings) > 3:
        print(f"    - ... {len(findings) - 3} more")

def inbox_summary():
    inbox_dir = ct2_dir / "inbox"
    if not inbox_dir.is_dir():
        return

    has_unread = False
    for role_dir in sorted(inbox_dir.iterdir()):
        if not role_dir.is_dir():
            continue
        role = role_dir.name
        # Count messages not in processing/ or done/
        msgs = [f for f in role_dir.glob("*.md") if f.is_file()]
        count = len(msgs)
        if not has_unread and count > 0:
            has_unread = True

        if count > 0:
            print(f"  {role:<14} {count} unread", end="")
            # Show first two message subjects
            for i, msg in enumerate(sorted(msgs)[:2]):
                fm = read_frontmatter(msg)
                msg_type = fm.get("type", "info")
                from_role = fm.get("from", "?")
                ticket = fm.get("ticket", "?")
                m_id = re.match(r'(\d+)', ticket)
                ticket_ref = f"[{m_id.group(1)}]" if m_id else f"[{ticket}]"
                if i == 0:
                    print(f"   {msg_type} from {from_role} {ticket_ref}")
                else:
                    print(f"{'':>31}{msg_type} from {from_role} {ticket_ref}")
        else:
            print(f"  {role:<14} 0 unread")

    if not has_unread:
        print("  (no unread messages)")

def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}

def codex_summary():
    codex_dir = ct2_dir / "codex"
    if not codex_dir.is_dir():
        print("CODEX")
        print("  (no Codex metadata)")
        return

    print("CODEX")
    goal_dir = codex_dir / "goals"
    goals = sorted(goal_dir.glob("*.json")) if goal_dir.is_dir() else []
    if goals:
        for goal_path in goals:
            goal = load_json(goal_path)
            role = goal.get("role", "?")
            status = goal.get("status", "?")
            wait = goal.get("wait_state") or "-"
            scope = goal.get("scope_id") or "-"
            slug = goal.get("goal_slug") or goal_path.stem
            updated = goal.get("updated") or goal.get("created")
            print(f"  goal {slug} role={role} status={status} wait={wait} scope={scope} updated={updated}")
    else:
        print("  goals: none")

    thread_dir = codex_dir / "threads"
    threads = sorted(thread_dir.glob("*.json")) if thread_dir.is_dir() else []
    for thread_path in threads:
        thread = load_json(thread_path)
        role = thread.get("role", thread_path.stem)
        mode = thread.get("mode", "?")
        thread_id = thread.get("thread_id") or "-"
        goal = thread.get("goal") or {}
        goal_status = goal.get("status", "-") if isinstance(goal, dict) else "-"
        wait = thread.get("wait_state") or "-"
        print(f"  thread {role} mode={mode} thread={thread_id} goal={goal_status} wait={wait}")

    preflight_path = codex_dir / "preflight.json"
    if preflight_path.exists():
        preflight = load_json(preflight_path)
        version = preflight.get("codex_version") or "unknown"
        req = preflight.get("request_input_setup") or {}
        req_state = req.get("state", "?") if isinstance(req, dict) else "?"
        degradations = preflight.get("degradations") or []
        checked = preflight.get("checked_at") or "unknown"
        print(f"  preflight codex={version} request-input={req_state} checked={checked}")
        if degradations:
            print(f"  degraded: {len(degradations)} warning(s)")
            for item in degradations[:3]:
                print(f"    - {item}")
            if len(degradations) > 3:
                print(f"    - ... {len(degradations) - 3} more")

def scorecard_summary():
    baseline_path = ct2_dir / "telemetry" / "baseline-2026-05.json"
    if not baseline_path.exists():
        return
    baseline = load_json(baseline_path)
    scorecard = baseline.get("scorecard") or {}
    print("SCORECARD")
    labels = (
        ("Trust", "trust", "observed_ratio"),
        ("Evidence", "evidence", "observed_ratio"),
        ("Autonomy", "autonomy", "review_latency_p95_seconds"),
        ("Cost/Latency", "cost_latency", "cost_usd_total"),
    )
    for label, key, metric in labels:
        section = scorecard.get(key) if isinstance(scorecard.get(key), dict) else {}
        status = section.get("status", "unknown")
        value = section.get(metric)
        sample = section.get("sample_size", section.get("cost_sample_size", "-"))
        print(f"  {label:<12} status={status} sample={sample} {metric}={value}")

def runtime_doctor_summary():
    cap_path = ct2_dir / "runtime" / "capabilities.json"
    if not cap_path.exists():
        if doctor_mode:
            print("DOCTOR")
            print("  capabilities: missing (run ct2-runtime-doctor)")
        return
    cap = load_json(cap_path)
    runtimes = cap.get("runtimes") if isinstance(cap.get("runtimes"), dict) else {}

    def state(name: str) -> str:
        runtime = runtimes.get(name) if isinstance(runtimes.get(name), dict) else {}
        return "available" if runtime.get("available") else "missing"

    print("DOCTOR")
    print(f"  capabilities: codex={state('codex')} claude={state('claude')}")
    degradations = cap.get("degradations") if isinstance(cap.get("degradations"), list) else []
    if degradations:
        print(f"  degradations: {len(degradations)}")
        for item in degradations[:3]:
            print(f"    - {item}")

# ── Output ────────────────────────────────────────────────────────────────────
print(f"CT2 Status: {project_dir}")
print(SEP)

list_state(ct2_dir / "draft",       "DRAFT")
list_state(ct2_dir / "backlog",     "BACKLOG")
list_state(ct2_dir / "in-progress", "IN-PROG")
list_state(ct2_dir / "in-review",   "IN-REVIEW")
list_state(ct2_dir / "rejected",    "REJECTED")
list_state(ct2_dir / "escalated",   "ESCALATED")
list_state(ct2_dir / "done",        "DONE")

print(SEP)
workflow_summary()
print(SEP)
protocol_summary()
print(SEP)
github_summary()
print(SEP)
print("INBOX")
inbox_summary()
print(SEP)
codex_summary()
print(SEP)
scorecard_summary()
if (ct2_dir / "telemetry" / "baseline-2026-05.json").exists():
    print(SEP)
if doctor_mode or (ct2_dir / "runtime" / "capabilities.json").exists():
    runtime_doctor_summary()
    print(SEP)
