#!/usr/bin/env python3
"""Adopt an existing GitHub Issue as a CT2 draft ticket."""

from __future__ import annotations

import argparse
import fcntl
import json
import re
import sys
from pathlib import Path

from _ct2_issue import run_gh
from _ct2_protocol import assert_compatible as assert_protocol_compatible
from _ct2_vao import atomic_write_text, ensure_ct2, now, read_frontmatter


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return re.sub(r"-{2,}", "-", slug) or "github-issue"


def next_ticket_id(ct2_dir: Path) -> str:
    highest = 0
    for state in ("draft", "backlog", "in-progress", "in-review", "rejected", "escalated", "done"):
        for path in (ct2_dir / state).glob("*.md"):
            match = re.match(r"^(\d+)", path.stem)
            if match:
                highest = max(highest, int(match.group(1)))
    return f"{highest + 1:03d}"


def existing_issue_ticket(ct2_dir: Path, issue: str) -> Path | None:
    for state in ("draft", "backlog", "in-progress", "in-review", "rejected", "escalated", "done"):
        for path in (ct2_dir / state).glob("*.md"):
            if str(read_frontmatter(path).get("issue", "")).strip('"') == issue:
                return path
    return None


def gh_issue(project_dir: Path, issue: str) -> dict[str, str]:
    proc = run_gh(["issue", "view", issue, "--json", "title,body,number,url"], project_dir)
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"gh issue view returned invalid JSON: {exc}") from exc
    return {key: str(data.get(key, "") or "") for key in ("title", "body", "number", "url")}


def yaml_single_quote(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"


def draft_text(ticket_id: str, title: str, issue: str, issue_url: str, body: str) -> str:
    clipped = body[:8192]
    if len(body) > len(clipped):
        clipped += "\n\n[Original issue body truncated at 8 KB.]"
    timestamp = now()
    return f"""---
id: "{ticket_id}"
title: {yaml_single_quote(title)}
status: draft
priority: medium
created: {timestamp}
updated: {timestamp}
sealed: null
branch: null
pr: null
issue: {issue}
issue-url: {issue_url}
issue-source: adopted
review-round: 0
duration-bounce-count: 0
total-attempts: 0
estimated-scope: small
touched-files:
  - TBD
review-status:
  lens-claude:
    status: pending
    sidecar: null
  lens-codex:
    status: pending
    sidecar: null
verdict: pending
---

## Requirements
- [ ] Refine the adopted GitHub Issue into CT2 requirements.

## Constraints
- Preserve the original issue context below while refining scope.

## Context
Adopted from GitHub Issue #{issue}: {issue_url}

### Original Issue Body

{clipped}

## Acceptance Criteria
- [ ] The adopted issue has been refined into verifiable acceptance criteria.
"""


def main() -> int:
    parser = argparse.ArgumentParser(description="Adopt an existing GitHub Issue as a CT2 draft ticket")
    parser.add_argument("issue")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    project_dir = Path(args.project_dir).resolve()
    try:
        ct2_dir = ensure_ct2(project_dir)
        assert_protocol_compatible(project_dir)
        issue = str(int(args.issue))
        existing = existing_issue_ticket(ct2_dir, issue)
        if existing is not None:
            raise RuntimeError(f"issue #{issue} is already linked to {existing.name}")
        data = gh_issue(project_dir, issue)
        lock_path = ct2_dir / ".adopt.lock"
        with lock_path.open("w", encoding="utf-8") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            existing = existing_issue_ticket(ct2_dir, issue)
            if existing is not None:
                raise RuntimeError(f"issue #{issue} is already linked to {existing.name}")
            ticket_id = next_ticket_id(ct2_dir)
            title = data["title"] or f"GitHub Issue {issue}"
            dest = ct2_dir / "draft" / f"{ticket_id}-{slugify(title)}.md"
            if dest.exists():
                raise RuntimeError(f"destination already exists: {dest}")
            atomic_write_text(ct2_dir, dest, draft_text(ticket_id, title, issue, data["url"], data["body"]), "issue-adopt-")
        comment = f"Adopted as CT2 ticket {ticket_id}; CT2 will update this issue as work progresses."
        run_gh(["issue", "comment", issue, "--body", comment], project_dir, check=False)
        result = {"ticket": dest.name, "issue": issue, "issue_url": data["url"], "path": f".ct2/draft/{dest.name}"}
    except Exception as exc:
        print(f"ct2-issue-adopt: {exc}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"ct2-issue-adopt: issue #{result['issue']} -> {result['path']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
