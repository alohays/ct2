#!/usr/bin/env python3
"""Publish CT2 merge-ready or reconciler summary comments to a PR."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from _ct2_issue import find_ticket
from _ct2_pr import publish_merge_ready, publish_reconciler_summary
from _ct2_protocol import assert_compatible as assert_protocol_compatible
from _ct2_vao import ensure_ct2


def main() -> int:
    parser = argparse.ArgumentParser(description="Publish CT2 merge-ready PR comments")
    parser.add_argument("ticket", help="Ticket path, id, stem, or filename")
    parser.add_argument("project_dir", nargs="?", default=".")
    parser.add_argument("--reviewer", choices=("lens-cc", "lens-cx"), help="Lens reviewer posting merge-ready")
    parser.add_argument("--reconciler-summary", action="store_true", help="Post the reconciler terminal summary")
    parser.add_argument("--verdict", default="approved")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    project_dir = Path(args.project_dir).resolve()
    try:
        ct2_dir = ensure_ct2(project_dir)
        assert_protocol_compatible(project_dir)
        ticket = find_ticket(ct2_dir, args.ticket)
        if ticket is None:
            raise RuntimeError(f"ticket not found: {args.ticket}")
        if args.reconciler_summary:
            result = publish_reconciler_summary(project_dir, ticket, args.verdict)
        else:
            if not args.reviewer:
                raise RuntimeError("--reviewer is required unless --reconciler-summary is used")
            result = publish_merge_ready(project_dir, ticket, args.reviewer)
    except Exception as exc:
        print(f"ct2-pr-merge-ready: {exc}", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"ct2-pr-merge-ready: {result['ticket']} {result['status']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
