#!/usr/bin/env python3
"""Run a CT2 role command and append cost/latency telemetry."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

from _ct2_vao import append_jsonl, ensure_ct2, new_id, now


def env_number(name: str, default: float = 0.0) -> float:
    try:
        return float(os.environ.get(name, default) or default)
    except ValueError:
        return default


def env_int(name: str, default: int = 0) -> int:
    try:
        return int(os.environ.get(name, default) or default)
    except ValueError:
        return default


def main() -> int:
    parser = argparse.ArgumentParser(description="Run a CT2 role command with cost telemetry")
    parser.add_argument("--project-dir", default=".")
    parser.add_argument("--role", required=True)
    parser.add_argument("--ticket")
    parser.add_argument("--goal")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()

    command = args.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        print("ct2-role-run: command required after --", file=sys.stderr)
        return 2

    project_dir = Path(args.project_dir).resolve()
    ct2_dir = ensure_ct2(project_dir)
    started = time.monotonic()
    started_at = now()
    proc = subprocess.run(command, cwd=str(project_dir), text=True, check=False)
    duration_ms = int((time.monotonic() - started) * 1000)
    event = {
        "id": new_id("cost"),
        "timestamp": started_at,
        "role": args.role,
        "ticket": args.ticket,
        "goal": args.goal,
        "command": command[0],
        "exit_code": proc.returncode,
        "duration_ms": duration_ms,
        "usd": env_number("CT2_COST_USD", 0.0),
        "input_tokens": env_int("CT2_INPUT_TOKENS", 0),
        "output_tokens": env_int("CT2_OUTPUT_TOKENS", 0),
    }
    append_jsonl(ct2_dir, ct2_dir / "telemetry" / "cost.jsonl", event)
    return proc.returncode


if __name__ == "__main__":
    raise SystemExit(main())
