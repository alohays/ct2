#!/usr/bin/env python3
"""Move an in-progress CT2 ticket into review and stamp review entry time."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

from _ct2_protocol import assert_compatible as assert_protocol_compatible
from _ct2_vao import atomic_write_text, ensure_ct2, now, ticket_id_from_name

# The three named checks the submit gate evaluates. Deliberately NOT the full
# audit report nor its exit code: an in-progress audit also fails
# `required_frontmatter` for legitimate `branch: null` tickets (direct-to-main /
# none strategies) and `sealed_baseline` for legacy tickets, neither of which is
# a submission precondition. Gating on the exit code would brick those projects.
SUBMIT_GATE_CHECKS = ("submit_gate_state", "acceptance_criteria_checked", "plan_evidence")


def resolve_ticket(ct2_dir: Path, arg: str) -> Path | None:
    root = ct2_dir / "in-progress"
    if (root / arg).is_file():
        return root / arg
    if (root / f"{arg}.md").is_file():
        return root / f"{arg}.md"
    matches = sorted(root.glob(f"{arg}-*.md"))
    if len(matches) == 1:
        return matches[0]
    return None


def replace_frontmatter_value(text: str, key: str, value: str) -> str:
    pattern = rf"^({re.escape(key)}:\s*).*$"
    if re.search(pattern, text, re.MULTILINE):
        return re.sub(pattern, rf"\g<1>{value}", text, count=1, flags=re.MULTILINE)
    return re.sub(r"^(---\n)", rf"\g<1>{key}: {value}\n", text, count=1)


def mirror_issue(project_dir: Path, ticket: Path) -> None:
    helper = Path(__file__).resolve().parent / "ct2-issue-mirror"
    subprocess.run([sys.executable, str(helper), str(ticket), str(project_dir)], cwd=str(project_dir), check=False)


def submit_gate(project_dir: Path, ticket_id: str) -> tuple[bool, list[dict[str, object]]]:
    """Run ct2-ticket-audit --submit-gate and evaluate only SUBMIT_GATE_CHECKS.

    Fail-closed: a parse failure, a missing ticket, or a changed audit shape
    blocks the submit rather than letting an unverified ticket through a hard
    gate.
    """
    helper = Path(__file__).resolve().parent / "ct2-ticket-audit"
    proc = subprocess.run(
        [sys.executable, str(helper), "--json", "--submit-gate", "--ticket", ticket_id, str(project_dir)],
        cwd=str(project_dir),
        capture_output=True,
        text=True,
        check=False,
    )
    try:
        report = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return False, [{"name": "submit_gate_audit", "ok": False, "evidence": (proc.stderr or proc.stdout)[:400]}]
    tickets = report.get("tickets", [])
    if not tickets:
        return False, [{"name": "submit_gate_ticket_found", "ok": False, "evidence": report.get("errors")}]
    gate = [item for item in tickets[0].get("checks", []) if item.get("name") in SUBMIT_GATE_CHECKS]
    if len(gate) != len(SUBMIT_GATE_CHECKS):
        return False, gate
    return all(item.get("ok") for item in gate), gate


def main() -> int:
    parser = argparse.ArgumentParser(description="Move one CT2 ticket from in-progress to in-review")
    parser.add_argument("ticket")
    parser.add_argument("project_dir", nargs="?", default=".")
    args = parser.parse_args()

    project_dir = Path(args.project_dir).resolve()
    ct2_dir = ensure_ct2(project_dir)
    try:
        assert_protocol_compatible(project_dir)
    except Exception as exc:
        print(f"ct2-review-enter: {exc}", file=sys.stderr)
        return 2
    ticket = resolve_ticket(ct2_dir, args.ticket)
    if ticket is None:
        print(f"ct2-review-enter: ticket {args.ticket!r} not found in .ct2/in-progress/", file=sys.stderr)
        return 1

    ticket_id = ticket_id_from_name(ticket)
    gate_ok, gate_checks = submit_gate(project_dir, ticket_id)
    if not gate_ok:
        print("ct2-review-enter: submit gate failed — ticket stays in in-progress/", file=sys.stderr)
        for item in gate_checks:
            if not item.get("ok"):
                print(f"  fail: {item.get('name')} — {item.get('evidence')}", file=sys.stderr)
        return 2

    dest = ct2_dir / "in-review" / ticket.name
    if dest.exists():
        print(f"ct2-review-enter: destination already exists: {dest.name}", file=sys.stderr)
        return 2

    os.rename(ticket, dest)
    text = dest.read_text(encoding="utf-8")
    text = replace_frontmatter_value(text, "status", "in-review")
    text = replace_frontmatter_value(text, "updated", now())
    atomic_write_text(ct2_dir, dest, text, "review-enter-ticket-")

    started = ct2_dir / ".meta" / f"{ticket_id}.started"
    try:
        started.unlink()
    except FileNotFoundError:
        pass
    atomic_write_text(ct2_dir, ct2_dir / ".meta" / f"{ticket_id}.in-review", now() + "\n", "review-enter-stamp-")
    with (ct2_dir / "logs" / "ct2-forge.log").open("a", encoding="utf-8") as log:
        log.write(f"[{now()}] submit ticket={ticket_id} -> in-review\n")
    mirror_issue(project_dir, dest)

    print(f"ct2-review-enter: {dest.name} -> in-review")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
