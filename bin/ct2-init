#!/usr/bin/env bash
# ct2-init — Initialize the CT2 protocol ledger in a project directory.
# Usage: ct2-init [--repair] [--install-trace-hook] [--uninstall-trace-hook] [--bootstrap-issue-labels] [project-dir]
# If project-dir is omitted, uses the current working directory.

set -euo pipefail

CT2_REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TRACE_HOOK_MARKER="# ct2-trace-hook: v2"

# ── Parse flags ───────────────────────────────────────────────────────────────
REPAIR=false
INSTALL_TRACE_HOOK=false
BOOTSTRAP_ISSUE_LABELS=false
UNINSTALL_TRACE_HOOK=false
POSITIONAL=()
for arg in "$@"; do
  case "$arg" in
    --repair) REPAIR=true ;;
    --install-trace-hook) INSTALL_TRACE_HOOK=true ;;
    --bootstrap-issue-labels) BOOTSTRAP_ISSUE_LABELS=true ;;
    --uninstall-trace-hook) UNINSTALL_TRACE_HOOK=true ;;
    --help|-h)
      echo "Usage: ct2-init [--repair] [--install-trace-hook] [--uninstall-trace-hook] [--bootstrap-issue-labels] [project-dir]"
      echo "  --repair                  Fill missing directories and config files without overwriting existing state"
      echo "  --install-trace-hook      Install a local pre-push hook that runs ct2-trace-lint --strict"
      echo "  --uninstall-trace-hook    Remove a ct2-managed local pre-push hook"
      echo "  --bootstrap-issue-labels  Create/update CT2 GitHub Issue column labels via gh"
      exit 0 ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done

if [[ "$INSTALL_TRACE_HOOK" == true && "$UNINSTALL_TRACE_HOOK" == true ]]; then
  echo "ct2-init: choose only one of --install-trace-hook or --uninstall-trace-hook" >&2
  exit 1
fi

# ── Resolve target project directory ──────────────────────────────────────────
PROJECT_DIR="${POSITIONAL[0]:-$(pwd)}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
CT2_DIR="${PROJECT_DIR}/.ct2"

if [[ -d "$CT2_DIR" ]] && [[ "$REPAIR" == false ]]; then
  echo "ct2: .ct2/ already exists in ${PROJECT_DIR}. Use --repair to fill missing files." >&2
  exit 0
fi

if [[ "$REPAIR" == true ]]; then
  echo "ct2-init: repairing ${CT2_DIR}"
else
  echo "ct2-init: initializing ${PROJECT_DIR}"
fi

# ── Create Kanban directories ──────────────────────────────────────────────────
for dir in \
  draft backlog in-progress in-review rejected escalated done \
  reviews reviews/.archive worktrees logs \
  runtime runtime/artifacts runtime/provider-hooks telemetry evidence evidence/commands evidence/artifacts evidence/screenshots evidence/verifiers evidence/hooks \
  decisions/pending decisions/answered decisions/expired decisions/audit \
  plans plans/canvas/open plans/canvas/answered plans/canvas/sealed plans/canvas/expired \
  watchers postmortems \
  evals/ct2-helm evals/ct2-forge evals/ct2-lens-cc evals/ct2-lens-cx
do
  mkdir -p "${CT2_DIR}/${dir}"
done

# ── Create inbox per-role directories ─────────────────────────────────────────
for role in ct2-helm ct2-forge ct2-lens-cc ct2-lens-cx ct2-helm-auto-cx; do
  mkdir -p "${CT2_DIR}/inbox/${role}/processing"
  mkdir -p "${CT2_DIR}/inbox/${role}/done"
done

# ── Create support directories ─────────────────────────────────────────────────
mkdir -p "${CT2_DIR}/config"
mkdir -p "${CT2_DIR}/codex/threads"
mkdir -p "${CT2_DIR}/codex/goals"
mkdir -p "${CT2_DIR}/codex/scopes"
mkdir -p "${CT2_DIR}/codex/ledgers"
mkdir -p "${CT2_DIR}/.meta"
mkdir -p "${CT2_DIR}/.migrations"
mkdir -p "${CT2_DIR}/.tmp"

# ── Stamp the project protocol version ───────────────────────────────────────
PROTOCOL_VERSION=$(python3 - "${CT2_REPO_DIR}/VERSION" <<'PYEOF'
import re, sys
version = open(sys.argv[1], encoding="utf-8").read().strip()
match = re.fullmatch(r"(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)", version)
if not match:
    raise SystemExit(f"invalid CT2 VERSION: {version!r}")
print(f"{match.group(1)}.{match.group(2)}")
PYEOF
)
if [[ ! -f "${CT2_DIR}/.protocol-version" ]]; then
  PROTOCOL_TMP=$(mktemp "${CT2_DIR}/.tmp/protocol-version-XXXXXX")
  printf "%s\n" "$PROTOCOL_VERSION" > "$PROTOCOL_TMP"
  mv -n "$PROTOCOL_TMP" "${CT2_DIR}/.protocol-version" 2>/dev/null
  if [[ -f "$PROTOCOL_TMP" ]]; then
    rm -f "$PROTOCOL_TMP"
  else
    echo "  wrote: .protocol-version (${PROTOCOL_VERSION})"
  fi
fi

# ── Copy default config files (skip existing to preserve project customization) ─
_copy_if_missing() {
  local src="$1" dst="$2"
  if [[ ! -f "$dst" ]]; then
    cp "$src" "$dst"
    echo "  copied: $(basename "$dst")"
  fi
}
_copy_if_missing "${CT2_REPO_DIR}/config/harness.yaml"          "${CT2_DIR}/config/harness.yaml"
_copy_if_missing "${CT2_REPO_DIR}/config/ct2-lens-cc-role.md"   "${CT2_DIR}/config/ct2-lens-cc-role.md"
_copy_if_missing "${CT2_REPO_DIR}/config/ct2-lens-cx-role.md"   "${CT2_DIR}/config/ct2-lens-cx-role.md"
_copy_if_missing "${CT2_REPO_DIR}/config/ct2-reconciler-ref.md" "${CT2_DIR}/config/ct2-reconciler-ref.md"

# ── Copy default VAO eval cases and watcher templates ────────────────────────
for role in ct2-helm ct2-forge ct2-lens-cc ct2-lens-cx; do
  mkdir -p "${CT2_DIR}/evals/${role}/cases"
  if [[ -d "${CT2_REPO_DIR}/config/evals/${role}" ]]; then
    for src in "${CT2_REPO_DIR}/config/evals/${role}"/*.json; do
      [[ -e "$src" ]] || continue
      _copy_if_missing "$src" "${CT2_DIR}/evals/${role}/cases/$(basename "$src")"
    done
  fi
done

if [[ -d "${CT2_REPO_DIR}/config/watchers" ]]; then
  for src in "${CT2_REPO_DIR}/config/watchers"/*.json; do
    [[ -e "$src" ]] || continue
    _copy_if_missing "$src" "${CT2_DIR}/watchers/$(basename "$src")"
  done
fi

# ── Copy ticket template ───────────────────────────────────────────────────────
_copy_if_missing "${CT2_REPO_DIR}/templates/ticket.md" "${CT2_DIR}/ticket.template.md"

# ── Create stub log files ─────────────────────────────────────────────────────
touch "${CT2_DIR}/logs/ct2-forge.log"
touch "${CT2_DIR}/logs/ct2-lens-cx.log"
touch "${CT2_DIR}/logs/ct2-helm-auto-cx.log"

# ── Initialize circuit-breaker state file (skip if exists) ───────────────────
if [[ ! -f "${CT2_DIR}/.meta/circuit-breaker.json" ]]; then
  cat > "${CT2_DIR}/.meta/circuit-breaker.json" <<'EOF'
{
  "tripped": false,
  "tripped_tickets": []
}
EOF
fi

# ── Exclude .ct2/ from git (without modifying .gitignore) ────────────────────
# Use git rev-parse to handle both normal repos and worktrees (.git as file)
IS_GIT_REPO=false
if git -C "$PROJECT_DIR" rev-parse --git-common-dir &>/dev/null; then
  IS_GIT_REPO=true
  GIT_DIR_RESOLVED="$(git -C "$PROJECT_DIR" rev-parse --git-common-dir)"
  # Make absolute if relative
  [[ "$GIT_DIR_RESOLVED" == /* ]] || GIT_DIR_RESOLVED="${PROJECT_DIR}/${GIT_DIR_RESOLVED}"
  GIT_EXCLUDE="${GIT_DIR_RESOLVED}/info/exclude"
  mkdir -p "$(dirname "$GIT_EXCLUDE")"
  if ! grep -qxF '.ct2/' "$GIT_EXCLUDE" 2>/dev/null; then
    echo '.ct2/' >> "$GIT_EXCLUDE"
    echo "ct2-init: added .ct2/ to ${GIT_EXCLUDE}"
  fi
else
  echo "ct2-init: warning — not a git repository; .ct2/ will not be git-excluded" >&2
  echo "  CT2 workflows (forge, lens) depend on git. Consider initializing git first." >&2
fi

# ── Optional local pre-push verifier hook ────────────────────────────────────
if [[ "$INSTALL_TRACE_HOOK" == true || "$UNINSTALL_TRACE_HOOK" == true ]]; then
  if [[ "$IS_GIT_REPO" == false ]]; then
    echo "ct2-init: warning — cannot manage trace hook outside a git repository" >&2
  else
    HOOK_PATH="${GIT_DIR_RESOLVED}/hooks/pre-push"
    mkdir -p "$(dirname "$HOOK_PATH")"
    if [[ "$UNINSTALL_TRACE_HOOK" == true ]]; then
      if [[ -e "$HOOK_PATH" ]] && grep -q "ct2-trace-lint" "$HOOK_PATH" 2>/dev/null; then
        rm -f "$HOOK_PATH"
        echo "ct2-init: removed trace verifier hook at ${HOOK_PATH}"
      elif [[ -e "$HOOK_PATH" ]]; then
        echo "ct2-init: warning — existing non-ct2 pre-push hook left unchanged: ${HOOK_PATH}" >&2
      else
        echo "ct2-init: no trace hook installed at ${HOOK_PATH}"
      fi
    elif [[ -e "$HOOK_PATH" ]] && ! grep -q "ct2-trace-lint" "$HOOK_PATH" 2>/dev/null; then
      echo "ct2-init: warning — existing pre-push hook left unchanged: ${HOOK_PATH}" >&2
    elif [[ -e "$HOOK_PATH" ]] && grep -qxF "$TRACE_HOOK_MARKER" "$HOOK_PATH" 2>/dev/null; then
      echo "ct2-init: trace hook already installed at ${HOOK_PATH}"
    else
      HOOK_TMP=$(mktemp "${GIT_DIR_RESOLVED}/hooks/pre-push-ct2-XXXXXX")
      cat > "$HOOK_TMP" <<EOF
#!/usr/bin/env bash
$TRACE_HOOK_MARKER
set -euo pipefail

ROOT="\$(git rev-parse --show-toplevel)"
if command -v ct2-trace-lint >/dev/null 2>&1; then
  exec ct2-trace-lint --strict "\$ROOT"
fi
exec "${CT2_REPO_DIR}/bin/ct2-trace-lint" --strict "\$ROOT"
EOF
      chmod +x "$HOOK_TMP"
      mv "$HOOK_TMP" "$HOOK_PATH"
      echo "ct2-init: installed trace verifier hook at ${HOOK_PATH}"
    fi
  fi
fi

if [[ "$BOOTSTRAP_ISSUE_LABELS" == true ]]; then
  if ! python3 "${CT2_REPO_DIR}/bin/ct2-issue-bootstrap-labels" "$PROJECT_DIR"; then
    echo "ct2-init: warning — GitHub Issue label bootstrap failed; continuing" >&2
  fi
fi

# ── Choose git workflow strategy ─────────────────────────────────────────────
# On fresh init + TTY, prompt. Otherwise fall back to a sensible default.
# See spec/git-workflow.md for the contract.
if [[ "$REPAIR" == false ]]; then
  if [[ "$IS_GIT_REPO" == false ]]; then
    GIT_STRATEGY="none"
    echo "ct2-init: git_strategy=none (not a git repository)"
  elif [[ -t 0 ]] && [[ -t 1 ]]; then
    echo ""
    echo "Choose the git workflow strategy for this project:"
    echo "  1) branch-per-ticket  — each ticket on feat/{id}-{slug}, PR opened at in-review (default, recommended)"
    echo "  2) direct-to-main     — forge commits directly to the base branch (no PR; single-author only)"
    echo "  3) none               — CT2 performs no git operations"
    echo ""
    printf "Selection [1]: "
    read -r CHOICE || CHOICE=""
    case "${CHOICE:-1}" in
      1|"") GIT_STRATEGY="branch-per-ticket" ;;
      2)    GIT_STRATEGY="direct-to-main"   ;;
      3)    GIT_STRATEGY="none"             ;;
      *)
        echo "ct2-init: invalid choice '${CHOICE}'; using default branch-per-ticket" >&2
        GIT_STRATEGY="branch-per-ticket"
        ;;
    esac
    echo "ct2-init: git_strategy=${GIT_STRATEGY}"
  else
    GIT_STRATEGY="branch-per-ticket"
  fi

  # Persist the selection by patching .ct2/config/harness.yaml in place.
  python3 - "${CT2_DIR}/config/harness.yaml" "$GIT_STRATEGY" <<'PYEOF'
import re, sys
path, strat = sys.argv[1], sys.argv[2]
c = open(path).read()
if re.search(r'^git_strategy:', c, re.MULTILINE):
    c = re.sub(r'^(git_strategy:\s*)\S+', rf'\g<1>{strat}', c, count=1, flags=re.MULTILINE)
    open(path, 'w').write(c)
PYEOF
fi

# ── Done ──────────────────────────────────────────────────────────────────────
echo ""
echo "✓ ct2 initialized at ${CT2_DIR}"
echo ""
echo "Next steps:"
echo "  1. Open a Claude Code session:   claude"
echo "  2. Enter the planner role:       /ct2:helm"
echo "  3. Author a ticket and seal it:  /ct2:helm → ct2-seal {ticket}"
echo "  4. Start the engineer loop:      claude → /ct2:forge"
echo "  5. Start the reviewer loop:      claude → /ct2:lens-cc"
echo "  6. Start the Codex reviewer:     ct2-lens-cx"
echo "  7. Check Codex support:          ct2-codex-doctor"
echo "  8. Verify host cleanliness:      ct2-trace-lint --strict"
echo "  9. Bootstrap issue labels:       ct2-issue-bootstrap-labels"
echo ""
echo "Run 'ct2-status' at any time to check the current state."
