#!/usr/bin/env bash
# ct2-lens-cx-daemon — Bash polling daemon for the Codex CLI-based lens-cx reviewer.
# Runs continuously, scanning .ct2/in-review/ every POLL_INTERVAL seconds.
# Invokes `codex` CLI to perform the review and writes sidecar files.
#
# Usage: ct2-lens-cx-daemon [project-dir]
#   project-dir defaults to $PWD
#
# Environment variables:
#   CT2_POLL_INTERVAL  Override polling interval (seconds). Default: 300.
#   CT2_CODEX_CMD      Override the codex CLI command. Default: codex.

set -euo pipefail

PROJECT_DIR="${1:-$(pwd)}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
CT2_DIR="${PROJECT_DIR}/.ct2"
CODEX_CMD="${CT2_CODEX_CMD:-codex}"
CODEX_TIMEOUT="${CT2_CODEX_TIMEOUT:-600}"  # 10 min default
DAEMON_LOG="${CT2_DIR}/logs/ct2-lens-cx.log"

# ── Signal trap for clean shutdown ────────────────────────────────────────────
cleanup() {
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] lens-cx: shutting down (signal received)" \
    | tee -a "$DAEMON_LOG" 2>/dev/null
  # Remove lockfiles owned by this PID
  find "${CT2_DIR}/.meta" -name '*-reconcile.lock' -type f 2>/dev/null | while read -r lf; do
    if [[ "$(cat "$lf" 2>/dev/null)" == "$$" ]]; then
      rm -f "$lf"
    fi
  done
  # Remove temp files created by this process
  find "${CT2_DIR}/.tmp" -name "cx-review-*" -type f 2>/dev/null -delete
  exit 0
}
trap cleanup SIGTERM SIGINT EXIT

# ── Validate .ct2/ ────────────────────────────────────────────────────────────
if [[ ! -d "$CT2_DIR" ]]; then
  echo "ct2-lens-cx-daemon: .ct2/ not found in ${PROJECT_DIR}" >&2
  echo "Run 'ct2-init' first." >&2
  exit 1
fi

if ! command -v "$CODEX_CMD" &>/dev/null; then
  echo "ct2-lens-cx-daemon: '${CODEX_CMD}' not found. Install the Codex CLI and retry." >&2
  exit 1
fi

# ── Resolve timeout command (GNU coreutils; macOS needs Homebrew) ────────────
if command -v timeout &>/dev/null; then
  TIMEOUT_CMD="timeout"
elif command -v gtimeout &>/dev/null; then
  TIMEOUT_CMD="gtimeout"
else
  # Pure-bash fallback: run command with a background watchdog
  _ct2_timeout() {
    local secs="$1"; shift
    "$@" &
    local cmd_pid=$!
    ( sleep "$secs" && kill "$cmd_pid" 2>/dev/null ) &
    local watchdog_pid=$!
    wait "$cmd_pid" 2>/dev/null
    local ret=$?
    kill "$watchdog_pid" 2>/dev/null; wait "$watchdog_pid" 2>/dev/null
    return $ret
  }
  TIMEOUT_CMD="_ct2_timeout"
fi

# ── Portable compact timestamp (GNU date supports %3N; BSD does not) ─────────
_ct2_compact_ts() {
  local ts
  ts=$(date -u +%Y%m%dT%H%M%S%NZ 2>/dev/null)
  if [[ "$ts" =~ [0-9]{8}T[0-9]{6}[0-9]+Z ]]; then
    # GNU date: truncate nanoseconds to 3 digits for millisecond precision
    echo "${ts:0:18}Z"
  else
    date -u +%Y%m%dT%H%M%SZ
  fi
}

mkdir -p "$(dirname "$DAEMON_LOG")"

log() {
  local ts; ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  echo "[${ts}] lens-cx: $*" | tee -a "$DAEMON_LOG"
}

# ── Read harness config ───────────────────────────────────────────────────────
POLL_INTERVAL="${CT2_POLL_INTERVAL:-}"
if [[ -z "$POLL_INTERVAL" ]]; then
  POLL_INTERVAL=$(python3 -c "
import re, sys
try:
    c = open(sys.argv[1]).read()
    m = re.search(r'poll_interval_sec:\s*(\d+)', c)
    print(m.group(1) if m else '300')
except Exception:
    print('300')
" "${CT2_DIR}/config/harness.yaml")
fi

MAX_REVIEW_ROUNDS=$(python3 -c "
import re, sys
try:
    c = open(sys.argv[1]).read()
    m = re.search(r'max_review_rounds:\s*(\d+)', c)
    print(m.group(1) if m else '3')
except Exception:
    print('3')
" "${CT2_DIR}/config/harness.yaml")

ROLE_FILE="${CT2_DIR}/config/ct2-lens-cx-role.md"

# ── Heartbeat update ──────────────────────────────────────────────────────────
update_heartbeat() {
  date -u > "${CT2_DIR}/.meta/ct2-lens-cx.heartbeat"
}

# ── Inbox polling ─────────────────────────────────────────────────────────────
poll_inbox() {
  local inbox_dir="${CT2_DIR}/inbox/ct2-lens-cx"
  for msg in "${inbox_dir}"/*.md; do
    [[ -f "$msg" ]] || continue
    local msgfile; msgfile=$(basename "$msg")
    # Atomic claim: mv -n then verify source is gone (macOS mv -n always returns 0)
    mv -n "$msg" "${inbox_dir}/processing/${msgfile}" 2>/dev/null
    if [[ ! -f "$msg" ]]; then
      local claimed="${inbox_dir}/processing/${msgfile}"
      log "inbox: processing ${msgfile}"
      # For now, log and acknowledge (helm handles escalation responses)
      mv -n "$claimed" "${inbox_dir}/done/${msgfile}" 2>/dev/null || true
    fi
  done
}

# ── Core review logic ─────────────────────────────────────────────────────────
review_ticket() {
  local ticket_path="$1"
  local ticket_file; ticket_file=$(basename "$ticket_path")
  local ticket_stem="${ticket_file%.md}"
  local ticket_id; ticket_id=$(echo "$ticket_stem" | grep -oE '^[0-9]+')

  local round; round=$(python3 -c "
import re, sys
c = open(sys.argv[1]).read()
m = re.search(r'review-round:\s*(\d+)', c)
print(m.group(1) if m else '0')
" "$ticket_path")

  local cx_sidecar="${CT2_DIR}/reviews/${ticket_id}-cx-r${round}.md"

  if [[ -f "$cx_sidecar" ]]; then
    return 0  # Already reviewed this round — idempotent
  fi

  log "reviewing ${ticket_file} (round ${round})"

  # Build the review prompt
  local ticket_content; ticket_content=$(cat "$ticket_path")
  local role_content; role_content=$(cat "$ROLE_FILE")

  local review_prompt
  read -r -d '' review_prompt <<PROMPT || true
${role_content}

---

You are reviewing the following CT2 ticket. The implementation has been completed by ct2-forge.

Review the changes in the working directory relative to the base branch, then produce a structured review sidecar in exactly this format:

---
ticket: ${ticket_stem}
reviewer: ct2-lens-cx
round: ${round}
verdict: <approved|rejected>
timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)
---

## Summary
<one-paragraph summary>

## Acceptance Criteria Check
<copy each AC item from the ticket and mark [x] or [ ] based on what you observe>

## Issues Found
<[BLOCKING] or [WARNING] items, or "(none)" if approved>

## Recommendation
<approved — reason> or <rejected — reason and remediation>

---

TICKET CONTENT:
${ticket_content}
PROMPT

  # Invoke codex to produce the review
  local tmp_review; tmp_review=$(mktemp "${CT2_DIR}/.tmp/cx-review-XXXXXX")
  if (cd "$PROJECT_DIR" && echo "$review_prompt" | "$TIMEOUT_CMD" "$CODEX_TIMEOUT" "$CODEX_CMD" --quiet --output-file "$tmp_review") 2>>"$DAEMON_LOG"; then
    # Validate verdict field in output
    if grep -qE '^verdict:\s*(approved|rejected)' "$tmp_review"; then
      mv -n "$tmp_review" "$cx_sidecar" 2>/dev/null
      if [[ -f "$tmp_review" ]]; then
        log "warning: sidecar already exists for $(basename "$cx_sidecar"); skipping"
        rm -f "$tmp_review"
        return 0
      fi
      log "sidecar written: $(basename "$cx_sidecar")"
      reconcile_ticket "$ticket_path" "$ticket_id" "$round"
    else
      log "warning: codex output missing verdict field; retrying next cycle"
      rm -f "$tmp_review"
    fi
  else
    log "error: codex invocation failed for ${ticket_file}"
    rm -f "$tmp_review"
  fi
}

# ── Reconciler ────────────────────────────────────────────────────────────────
reconcile_ticket() {
  local ticket_path="$1"
  local ticket_id="$2"
  local round="$3"

  local cc_sidecar="${CT2_DIR}/reviews/${ticket_id}-cc-r${round}.md"
  local cx_sidecar="${CT2_DIR}/reviews/${ticket_id}-cx-r${round}.md"

  [[ -f "$cc_sidecar" && -f "$cx_sidecar" ]] || return 0

  local lockfile="${CT2_DIR}/.meta/${ticket_id}-r${round}-reconcile.lock"
  if ! ( set -C; echo "$$" > "$lockfile" ) 2>/dev/null; then
    # Lock exists — decide if it is stale. `kill -0 $pid` alone is not enough
    # because PID reuse on long-running systems can mask a dead owner. We also
    # require the lockfile mtime to be recent (≤ 10 min); reconcile completes in
    # seconds, so any older lockfile is almost certainly abandoned.
    local lock_pid lock_mtime lock_age
    lock_pid=$(cat "$lockfile" 2>/dev/null || echo "")
    lock_mtime=$(stat -f %m "$lockfile" 2>/dev/null || stat -c %Y "$lockfile" 2>/dev/null || echo 0)
    lock_age=$(( $(date +%s) - lock_mtime ))
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null && (( lock_age < 600 )); then
      return 0  # Owner alive and lock recent — skip.
    fi
    # Stale lock — remove and retry.
    rm -f "$lockfile"
    ( set -C; echo "$$" > "$lockfile" ) 2>/dev/null || return 0
  fi

  local cc_v; cc_v=$(python3 -c "
import re, sys
c = open(sys.argv[1]).read()
m = re.search(r'verdict:\s*(\w+)', c)
print(m.group(1) if m else 'pending')" "$cc_sidecar")

  local cx_v; cx_v=$(python3 -c "
import re, sys
c = open(sys.argv[1]).read()
m = re.search(r'verdict:\s*(\w+)', c)
print(m.group(1) if m else 'pending')" "$cx_sidecar")

  log "reconcile: cc=${cc_v} cx=${cx_v}"

  local ticket_file; ticket_file=$(basename "$ticket_path")

  # Frontmatter mutations (verdict + updated + nested review-status.*) are
  # delegated to the shared helper so both reconcilers write identical output.
  # See bin/_ct2_update_verdict.py for the full contract.
  update_ticket_verdict() {
    local v="$1"
    "${BASH_SOURCE%/*}/_ct2_update_verdict.py" "$ticket_path" "$v" "$cc_sidecar" "$cx_sidecar"
  }

  # Guard: ticket may have been moved by a concurrent reconciler
  if [[ ! -f "${CT2_DIR}/in-review/${ticket_file}" ]]; then
    log "reconcile: ${ticket_file} already moved from in-review/; skipping"
    rm -f "$lockfile"
    return 0
  fi

  local src="${CT2_DIR}/in-review/${ticket_file}"
  if [[ "$cc_v" == "approved" && "$cx_v" == "approved" ]]; then
    update_ticket_verdict "approved"
    mv -n "$src" "${CT2_DIR}/done/${ticket_file}" 2>/dev/null
    [[ -f "$src" ]] && { log "error: failed to move ${ticket_file} to done/ (destination exists?)"; } \
                     || log "✓ ${ticket_file} → done"
  elif (( round + 1 >= MAX_REVIEW_ROUNDS )); then
    update_ticket_verdict "escalated"
    mv -n "$src" "${CT2_DIR}/escalated/${ticket_file}" 2>/dev/null
    [[ -f "$src" ]] && { log "error: failed to move ${ticket_file} to escalated/"; } \
                     || { log "⚡ ${ticket_file} → escalated (max rounds)"; send_escalation_message "$ticket_file" "$round"; }
  else
    update_ticket_verdict "rejected"
    mv -n "$src" "${CT2_DIR}/rejected/${ticket_file}" 2>/dev/null
    [[ -f "$src" ]] && { log "error: failed to move ${ticket_file} to rejected/"; } \
                     || log "✗ ${ticket_file} → rejected"
  fi

  rm -f "$lockfile"
}

# ── Inbox message sender ───────────────────────────────────────────────────────
send_escalation_message() {
  local ticket="$1" round="$2"
  local ts; ts=$(_ct2_compact_ts)
  local uid
  uid=$(uuidgen 2>/dev/null | tr -d '-' | head -c 8 || true)
  [[ -z "$uid" ]] && uid=$(od -An -tx1 -N4 /dev/urandom 2>/dev/null | tr -d ' \n' || true)
  [[ -z "$uid" ]] && uid=$(head -c 8 /dev/urandom | xxd -p | head -c 8 || true)
  local msgid="msg-${ts}-$$-${uid}"
  local tmp; tmp=$(mktemp "${CT2_DIR}/.tmp/${msgid}-XXXXXX")
  cat > "$tmp" <<MSGEOF
---
id: $msgid
from: ct2-lens-cx
to: ct2-helm
type: escalation
ticket: $ticket
timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)
---

## Subject
Ticket ${ticket} — Circuit Breaker Triggered (max_review_rounds=${MAX_REVIEW_ROUNDS})

## Body
Ticket ${ticket} failed to pass review after ${MAX_REVIEW_ROUNDS} rounds.
Please inspect the ticket manually and either revise or close it.
MSGEOF
  mv -n "$tmp" "${CT2_DIR}/inbox/ct2-helm/${msgid}.md" 2>/dev/null
  if [[ -f "$tmp" ]]; then rm -f "$tmp"; log "error: failed to send escalation message"; fi
}

# ── Main loop ─────────────────────────────────────────────────────────────────
log "ct2-lens-cx-daemon started (poll interval: ${POLL_INTERVAL}s)"
log "project: ${PROJECT_DIR}"

while true; do
  find "${CT2_DIR}/.tmp" -type f -mmin +60 -delete 2>/dev/null || true
  update_heartbeat

  poll_inbox

  # Scan in-review/ for tickets needing cx review
  for ticket in "${CT2_DIR}/in-review/"*.md; do
    [[ -f "$ticket" ]] || continue
    review_ticket "$ticket"
    update_heartbeat
  done

  sleep "$POLL_INTERVAL"
done
