#!/usr/bin/env python3
"""Verify the CT2 VAO implementation against its self-verification criteria."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

sys.dont_write_bytecode = True

from _ct2_vao import read_frontmatter, read_jsonl, ticket_id_from_name, now


